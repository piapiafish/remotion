const fs=require('node:fs'),path=require('node:path'),{execFileSync}=require('node:child_process');
const root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT;
const {chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
const {unzipSync,strFromU8,zipSync,strToU8}=require(path.join(root,'node_modules/fflate'));
const sample=path.join(root,'reports/current/p119-p125-implementation-20261103/private/user-baseline.mockup');
const report={date:new Date().toISOString(),checks:[],scenarios:[],pageErrors:[],consoleErrors:[],status:'RUNNING'};
const write=()=>fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));
function check(name,ok,detail){report.checks.push({name,status:ok?'PASS':'FAIL',detail});write();console.log((ok?'PASS ':'FAIL ')+name);if(!ok)throw Error(name)}
let browser,p,context;
async function session(){context=await browser.newContext({viewport:{width:1440,height:1000},acceptDownloads:true});await context.route('**/*',r=>['127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());
await context.addInitScript(()=>{window.auditVideos=[];const create=document.createElement.bind(document);document.createElement=(...args)=>{const el=create(...args);if(args[0]==='video')window.auditVideos.push(el);return el}});
p=await context.newPage();p.setDefaultTimeout(30000);p.on('pageerror',e=>{report.pageErrors.push(String(e));write()});p.on('console',m=>{if(m.type()==='error'){report.consoleErrors.push(m.text());write()}});p.on('dialog',d=>d.accept());await p.goto(process.env.STUDIO_URL+'/?automation=1',{waitUntil:'networkidle'});await p.evaluate(async()=>{window.S=(await import('/src/store/project.ts')).useProjectStore;window.T=await import('/src/timeline/sample.ts');window.G=await import('/src/scene/groundPlane.ts');window.B=await import('/src/scene/deviceBounds.ts');window.V=await import('/src/media/screenVideo.ts')});}
const state=()=>p.evaluate(()=>JSON.parse(JSON.stringify(window.S.getState().project)));
const ready=()=>p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(15000));
async function open(file=sample){await p.getByLabel('打开工程文件',{exact:true}).setInputFiles(file);await p.waitForFunction(()=>window.S.getState().editorPage==='editor'&&!window.S.getState().fileBusy);await ready();}
async function time(t){await p.getByRole('spinbutton',{name:'当前时间',exact:true}).fill(String(t));await p.getByRole('spinbutton',{name:'当前时间',exact:true}).press('Tab');}
async function select(index){const d=(await state()).devices[index];await p.getByTestId('object-'+d.instanceId).click();}
async function drag(box,from,to){await p.mouse.move(box.x+box.width*from,box.y+box.height/2);await p.mouse.down();await p.mouse.move(box.x+box.width*to,box.y+box.height/2,{steps:16});await p.mouse.up();}
async function scenario(name,fn){if(process.env.FEEDBACK_SCENARIOS&&!process.env.FEEDBACK_SCENARIOS.split(',').includes(name))return;await session();try{await fn();report.scenarios.push({name,status:'PASS'})}catch(error){report.scenarios.push({name,status:'FAIL',error:String(error)});await p.screenshot({path:path.join(out,name+'-failed.png'),fullPage:true}).catch(()=>{})}finally{write();await context.close()}}
async function still(name,t){const data=await p.evaluate(async t=>{const E=await import('/src/export/frameRenderer.ts'),R=await import('/src/export/renderer.ts'),F=await import('/src/scene/sceneEffects.ts');await F.settleEffectPreview();const ctx=R.getExportContext(),project=window.S.getState().project,bg=await(await import('/src/export/backdrop.ts')).loadBackdrop(project.background);const e=E.beginFrameExport({...ctx,project,backdrop:bg,width:1920,height:1080,quality:'standard'});try{const c=await e.renderAt(t,ctx.applyAt),blob=await c.convertToBlob({type:'image/png'});return Array.from(new Uint8Array(await blob.arrayBuffer()))}finally{e.dispose();bg?.dispose?.()}},t);fs.writeFileSync(path.join(out,name+'.png'),Buffer.from(data));}
async function save(name){const waiting=p.waitForEvent('download');await p.getByRole('button',{name:'保存工程',exact:true}).click();const d=await waiting,file=path.join(out,name+'.mockup');await d.saveAs(file);return {file,project:JSON.parse(strFromU8(unzipSync(fs.readFileSync(file))['project.json']))};}
(async()=>{try{browser=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',args:['--no-sandbox','--enable-webgl','--use-gl=angle','--enable-unsafe-swiftshader']});report.browser=browser.version();
await scenario('timeline-ground',async()=>{
 await open();const original=await state();check('legacy-orientation-preserved',original.devices[0].orientation==='landscape');check('orientation-buttons-removed',await p.getByTitle('横向',{exact:true}).count()===0&&await p.getByTitle('竖向',{exact:true}).count()===0);
 const before=await p.evaluate(()=>({p:JSON.stringify(window.S.getState().project),h:window.S.getState().history.past.length,a:window.S.getState().activeObject}));
 await drag(await p.locator('.object-lane').first().boundingBox(),.3,.8);check('empty-lane-continuous-scrub',Math.abs(await p.evaluate(()=>window.S.getState().playhead)-6.4)<.08);
 const after=await p.evaluate(()=>({p:JSON.stringify(window.S.getState().project),h:window.S.getState().history.past.length,a:window.S.getState().activeObject}));check('scrub-does-not-edit-document-or-selection',JSON.stringify(before)===JSON.stringify(after));
 await drag(await p.locator('.time-ruler').boundingBox(),.8,.1);check('ruler-continuous-scrub',Math.abs(await p.evaluate(()=>window.S.getState().playhead)-.8)<.08);
 const grip=await p.getByRole('button',{name:/^拖动播放头/}).first().boundingBox();await p.mouse.move(grip.x+grip.width/2,grip.y+grip.height/2);await p.mouse.down();const lane=await p.locator('.object-lane').first().boundingBox();await p.mouse.move(lane.x+lane.width*.5,grip.y+grip.height/2,{steps:12});await p.mouse.up();check('playhead-grip-can-drag',Math.abs(await p.evaluate(()=>window.S.getState().playhead)-4)<.08);
 await p.getByRole('button',{name:'放大时间轴',exact:true}).click();await p.getByRole('button',{name:'放大时间轴',exact:true}).click();await p.locator('.timeline-scroll').evaluate(el=>el.scrollLeft=260);const row=await p.locator('.object-lane').first().boundingBox(),view=await p.locator('.timeline-scroll').boundingBox(),x=view.x+view.width-40;await p.mouse.move(x-90,row.y+row.height/2);await p.mouse.down();await p.mouse.move(x,row.y+row.height/2,{steps:10});await p.mouse.up();const rect=await p.locator('.object-lane').first().boundingBox();check('scrolled-timeline-maps-real-content-coordinates',Math.abs(await p.evaluate(()=>window.S.getState().playhead)-(x-rect.x)/rect.width*8)<.1);
 await p.locator('.timeline-scroll').evaluate(el=>el.scrollLeft=0);await time(0);
 const result=await p.evaluate(()=>{const s=window.S.getState(),ground=s.project.environment.groundY,other=s.project.devices[0];s.setActiveDevice(1);s.beginEditGesture();s.setDeviceScale(3.5);s.setDevicePosition([0,-99,0]);s.endEditGesture();const project=window.S.getState().project,pose=window.T.sampleTimeline(project,0).devices[1];return {ground,after:project.environment.groundY,otherUnchanged:project.devices[0]===other,bottom:pose.position[1]-window.B.deviceHalfHeight(project.devices[1],pose),gap:window.B.CONTACT_GAP}});
 check('floor-fixed-and-other-device-independent',result.ground===result.after&&result.otherUnchanged,result);check('scale-and-downward-motion-stop-at-floor',Math.abs(result.bottom-result.ground-result.gap)<1e-6,result);
 await p.screenshot({path:path.join(out,'01-floor-contact.png'),fullPage:true});await p.getByRole('button',{name:'撤销',exact:true}).click();check('contact-and-scale-undo-together',JSON.stringify((await state()).devices)===JSON.stringify(original.devices));
 const range=await p.evaluate(()=>{const s=window.S.getState();s.setActiveDevice(1);s.addObjectKey({kind:'device',instanceId:s.project.devices[1].instanceId},0);s.setPlayhead(2);s.setDeviceRotation([.5,.7,Math.PI*4]);s.setDevicePosition([-.7,-10,0]);const project=window.S.getState().project;let min=Infinity;for(let i=0;i<=480;i++){const pose=window.T.sampleTimeline(project,i/60).devices[1];min=Math.min(min,pose.position[1]-window.B.deviceHalfHeight(project.devices[1],pose)-project.environment.groundY)}return {min,rotation:window.T.sampleTimeline(project,2).devices[1].rotation[2]}});check('intermediate-frames-and-720-turn-stay-above-ground',range.min>=.00199&&Math.abs(range.rotation-Math.PI*4)<1e-6,range);
 const saved=await save('grounded-user-project');await context.close();await session();await open(saved.file);check('fixed-ground-and-legacy-orientation-survive-fresh-session',(await state()).environment.groundY===saved.project.environment.groundY&&(await state()).devices[0].orientation==='landscape');
});
await scenario('replacement',async()=>{
 await p.getByTestId('template-duo-flat').click();await ready();await p.getByRole('textbox',{name:'工程名称',exact:true}).fill('保存前的工程');const before=await state();await p.getByRole('button',{name:'‹ 模板',exact:true}).click();await p.getByTestId('template-hero-tilt').click();const dialog=p.getByRole('dialog',{name:'未保存的修改'});await dialog.waitFor();check('three-clear-unsaved-options',await dialog.getByRole('button').count()===3);await p.screenshot({path:path.join(out,'02-three-options.png')});
 await dialog.getByRole('button',{name:'取消新建',exact:true}).click();check('cancel-keeps-project-and-history',JSON.stringify(await state())===JSON.stringify(before));
 await p.getByTestId('template-hero-tilt').click();await p.evaluate(()=>window.showSaveFilePicker=async()=>{throw new DOMException('cancelled','AbortError')});await dialog.getByRole('button',{name:'保存当前工程并新建工程',exact:true}).click();await p.getByText('已取消保存，当前工程仍保留。',{exact:true}).waitFor();check('cancel-file-save-does-not-replace',JSON.stringify(await state())===JSON.stringify(before));
 await p.evaluate(()=>window.showSaveFilePicker=async()=>({createWritable:async()=>({write:async()=>{throw Error('受控写入失败')},close:async()=>{},abort:async()=>{}})}));await dialog.getByRole('button',{name:'保存当前工程并新建工程',exact:true}).click();await p.getByText('保存未完成，当前工程仍保留，请重试。',{exact:true}).waitFor();check('save-failure-stays-on-current-project',JSON.stringify(await state())===JSON.stringify(before));
 await p.evaluate(()=>{window.showSaveFilePicker=async()=>{const dir=await navigator.storage.getDirectory();window.savedHandle=await dir.getFileHandle('test-confirmed.mockup',{create:true});return window.savedHandle}});await dialog.getByRole('button',{name:'保存当前工程并新建工程',exact:true}).click();await dialog.waitFor({state:'hidden'});await ready();const written=await p.evaluate(async()=>Array.from(new Uint8Array(await(await window.savedHandle.getFile()).arrayBuffer())));fs.writeFileSync(path.join(out,'save-before-new.mockup'),Buffer.from(written));const old=JSON.parse(strFromU8(unzipSync(Buffer.from(written))['project.json']));check('confirmed-write-finishes-before-new-project',old.name==='保存前的工程'&&(await state()).devices.length===1);
 await p.getByRole('textbox',{name:'工程名称',exact:true}).fill('保留到打开');await p.getByLabel('打开工程文件',{exact:true}).setInputFiles(sample);await dialog.waitFor();check('opening-file-also-offers-three-options',await dialog.getByRole('button',{name:'取消打开',exact:true}).count()===1);await dialog.getByRole('button',{name:'不保存当前工程并打开新工程'}).click();await p.waitForFunction(()=>window.S.getState().project.devices.length===3&&!window.S.getState().fileBusy);check('discard-opens-intended-file',(await state()).duration===8);
 await p.getByRole('textbox',{name:'工程名称',exact:true}).fill('损坏文件不能覆盖');await p.getByLabel('打开工程文件',{exact:true}).setInputFiles(path.join(root,'reports/current/p110-p118-implementation-20261102/workflow-final/bad.mockup'));await dialog.getByRole('button',{name:'不保存当前工程并打开新工程'}).click();await p.waitForFunction(()=>!window.S.getState().fileBusy);check('invalid-target-keeps-current-project',(await state()).name==='损坏文件不能覆盖');
});
await scenario('live-video',async()=>{
 await open();await select(0);await p.locator('.object-settings input[type=file]').setInputFiles(path.join(root,'reports/current/p106-20261102/reproduce/secondary-recording.mp4'));await ready();await p.getByRole('spinbutton',{name:'总时长',exact:true}).fill('18');await time(0);
 await p.evaluate(()=>{window.frames=[];for(const [index,v]of window.auditVideos.filter(v=>v.getAttribute('src')&&v.readyState>=2).entries()){const cb=(now,m)=>{window.frames.push({index,now,mediaTime:m.mediaTime,presentedFrames:m.presentedFrames,timeline:window.S.getState().playhead});v.requestVideoFrameCallback(cb)};v.requestVideoFrameCallback(cb)}});
 await p.getByRole('button',{name:'播放',exact:true}).click();await p.waitForTimeout(12000);await p.getByRole('button',{name:'暂停',exact:true}).click();const playback=await p.evaluate(()=>({frames:window.frames,status:window.V.screenVideoStatus(),time:window.S.getState().playhead,canvas:{width:window.__mockup.renderer.domElement.width,height:window.__mockup.renderer.domElement.height,css:window.__mockup.renderer.domElement.getBoundingClientRect().toJSON()}}));fs.writeFileSync(path.join(out,'playback.json'),JSON.stringify(playback,null,2));
 const groups=Object.values(Object.groupBy(playback.frames,f=>f.index));check('two-videos-decode-independently',groups.length>=2&&groups.every(g=>g.length>20),groups.map(g=>g.length));check('playing-source-frames-do-not-run-backwards',groups.every(g=>g.every((f,i)=>!i||f.mediaTime>=g[i-1].mediaTime-.02)));check('bounded-preview-resolution-is-higher-than-css',playback.canvas.width/playback.canvas.css.width>=1.49&&playback.canvas.width*playback.canvas.height<=3_210_000,playback.canvas);check('normal-playback-does-not-seek-every-frame',playback.status.every(v=>v.corrections<10),playback.status);
 await time(2.4);await p.waitForTimeout(500);await p.screenshot({path:path.join(out,'03-sharp-preview.png'),fullPage:true});await p.getByRole('tab',{name:'环境',exact:true}).click();await p.getByRole('checkbox',{name:'动态模糊',exact:true}).check();await p.getByRole('button',{name:'播放',exact:true}).click();await p.waitForTimeout(3000);const status=await p.evaluate(()=>window.V.screenVideoStatus());await p.getByRole('button',{name:'暂停',exact:true}).click();check('effect-playback-keeps-live-decoders-running',status.some(v=>!v.paused&&v.time>3),status);
});
await scenario('exports-regression',async()=>{
 await p.getByTestId('template-duo-flat').click();await ready();await p.getByRole('combobox',{name:'画幅',exact:true}).selectOption('16:9');await select(0);await p.locator('.object-settings input[type=file]').setInputFiles(path.join(root,'reports/current/p119-p125-implementation-20261103/private/user-recording.mp4'));await ready();await p.getByRole('button',{name:'添加文字',exact:true}).click();await p.getByRole('textbox',{name:'文字内容',exact:true}).fill('你好，更新后的宣传片');await p.evaluate(()=>{const s=window.S.getState();s.setActiveDevice(0);s.addObjectKey({kind:'device',instanceId:s.project.devices[0].instanceId},0);s.setPlayhead(2);s.setDeviceRotation([0,Math.PI*4,.3]);s.setDevicePosition([-.6,-4,0]);s.setDuration(4)});
 await p.getByRole('tab',{name:'环境',exact:true}).click();const dof=p.getByRole('checkbox',{name:'景深',exact:true}),blur=p.getByRole('checkbox',{name:'动态模糊',exact:true});for(const [name,a,b]of [['none',false,false],['dof',true,false],['blur',false,true],['combined',true,true]]){await dof.setChecked(a);await blur.setChecked(b);if(b)await p.getByRole('combobox',{name:'动态模糊质量',exact:true}).selectOption('2');await still(name,1)}check('all-four-effect-combinations-render',true);
 const saved=await save('feedback-scene');check('portable-save-preserves-ground-text-and-effects',saved.project.environment.groundY!==undefined&&saved.project.texts.length===1&&saved.project.effects.motionBlur.enabled);
 await p.getByRole('button',{name:'导出',exact:true}).click();await p.getByRole('button',{name:'标准',exact:true}).click();await p.screenshot({path:path.join(out,'04-before-export.png')});const wait=p.waitForEvent('download',{timeout:180000});wait.catch(()=>{});const failure=p.getByRole('dialog',{name:'导出作品',exact:true}).getByRole('alert').waitFor({timeout:180000}).then(async()=>{throw Error(await p.getByRole('dialog',{name:'导出作品',exact:true}).getByRole('alert').innerText())});failure.catch(()=>{});const progress=setInterval(()=>p.locator('.export-progress-bar').getAttribute('style',{timeout:1000}).then(x=>console.log('EXPORT '+x)).catch(()=>{}),10000);await p.getByRole('button',{name:'导出视频（MP4 (H.264)）',exact:true}).click();const dl=await Promise.race([wait,failure]).finally(()=>clearInterval(progress)),file=path.join(out,'feedback-1080p30.mp4');await dl.saveAs(file);const probe=JSON.parse(execFileSync('ffprobe',['-v','error','-count_frames','-show_streams','-show_format','-of','json',file],{encoding:'utf8'}));fs.writeFileSync(path.join(out,'ffprobe.json'),JSON.stringify(probe,null,2));check('actual-1080p30-4-second-video',probe.streams[0].width===1920&&probe.streams[0].height===1080&&Number(probe.streams[0].nb_read_frames)===120);
 await p.getByRole('button',{name:'关闭面板',exact:true}).click();await p.waitForTimeout(800);await p.getByRole('tab',{name:'对象',exact:true}).click();const project=await state();await p.getByTestId('object-'+project.texts[0].instanceId).click();await p.getByRole('textbox',{name:'文字内容',exact:true}).fill('导出后仍可编辑');await p.getByRole('button',{name:'撤销',exact:true}).click();check('editing-and-undo-return-after-effects-export',(await state()).texts[0].content==='你好，更新后的宣传片');
 await context.close();await session();await open(saved.file);check('fresh-session-portable-restore',JSON.stringify((await state()).devices.map(d=>d.transform))===JSON.stringify(saved.project.devices.map(d=>d.transform))&&(await state()).environment.groundY===saved.project.environment.groundY);
});
await scenario('ground-notice-specific',async()=>{
 const source=JSON.parse(strFromU8(unzipSync(fs.readFileSync(sample))['project.json']));source.name='触地提示检查';source.duration=4;source.devices=[source.devices[0]];const d=source.devices[0];d.id='procedural-phone';d.name='旧轨迹手机';d.orientation='portrait';d.screen=null;delete d.screenPlayback;delete source.environment.groundY;d.transform={};for(const c of ['position.x','position.y','position.z','rotation.x','rotation.y','rotation.z','scale'])d.transform[c]={keys:[{t:0,v:c==='scale'?1:0,ease:[0,0,1,1]}]};d.transform['position.y'].keys=[{t:0,v:0,ease:[0,0,1,1]},{t:.1,v:-10,ease:[0,0,1,1]},{t:.2,v:0,ease:[0,0,1,1]}];const file=path.join(out,'legacy-floor-dip.mockup');fs.writeFileSync(file,zipSync({'project.json':strToU8(JSON.stringify(source))}));await open(file);
 const message=await p.evaluate(async()=>(await import('/src/store/feedback.ts')).useFeedbackStore.getState().notice?.message);check('legacy-floor-conflict-identifies-affected-phone',message.includes('旧轨迹手机')&&message.includes('原关键帧保留'),message);check('legacy-dip-keys-are-not-rewritten',(await state()).devices[0].transform['position.y'].keys[1].v===-10);
 const safe=await p.evaluate(()=>{const project=window.S.getState().project,pose=window.T.sampleTimeline(project,.1).devices[0];return pose.position[1]-window.B.deviceHalfHeight(project.devices[0],pose)>=project.environment.groundY});check('short-unsampled-legacy-dip-is-constrained',safe);await p.screenshot({path:path.join(out,'legacy-floor-notice.png'),fullPage:true});
});
check('no-unhandled-page-errors',report.pageErrors.length===0,report.pageErrors);check('no-console-errors',report.consoleErrors.length===0,report.consoleErrors);report.status=report.scenarios.every(s=>s.status==='PASS')?'PASS':'FAIL';if(report.status!=='PASS')process.exitCode=1;
}catch(e){report.status='FAIL';report.error=String(e);process.exitCode=1}finally{write();await browser?.close();console.log(JSON.stringify({status:report.status,scenarios:report.scenarios,checks:report.checks.length}))}})();
