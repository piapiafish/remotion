const fs=require('node:fs'),path=require('node:path');
const root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT,{chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
const report={date:new Date().toISOString(),checks:[],pageErrors:[],status:'RUNNING'};let b,p;
const check=(name,ok,detail)=>{report.checks.push({name,status:ok?'PASS':'FAIL',detail});fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));if(!ok)throw Error(name);console.log('PASS '+name)};
(async()=>{try{b=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',args:['--no-sandbox','--enable-webgl','--use-gl=angle','--enable-unsafe-swiftshader']});const c=await b.newContext({viewport:{width:1440,height:1000}});await c.route('**/*',r=>['127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());p=await c.newPage();p.on('pageerror',e=>report.pageErrors.push(String(e)));await p.goto(process.env.STUDIO_URL+'/?automation=1',{waitUntil:'networkidle'});await p.getByTestId('template-hero-straight').click();await p.evaluate(async()=>{window.S=(await import('/src/store/project.ts')).useProjectStore;window.D=await import('/src/devices/manifest.ts');window.T=await import('/src/timeline/sample.ts')});
for(const [id,orientation]of [['procedural-phone','portrait'],['iphone-17-pro','landscape'],['iphone-17-pro-max','portrait'],['pixel-9-pro-xl','landscape'],['galaxy-s26-ultra','portrait']]){
 await p.evaluate(({id,orientation})=>{const s=window.S.getState();s.setActiveDevice(0);s.setDeviceId(id);s.setOrientation(orientation);s.setDeviceScale(1.1);s.setDeviceRotation([.25,.6,.4]);s.setDevicePosition([0,-10,0]);s.selectObject(null)}, {id,orientation});await p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(15000));await p.waitForTimeout(200);
 const measured=await p.evaluate(()=>{const ctx=window.__mockup;ctx.scene.updateMatrixWorld(true);let group;ctx.scene.traverse(o=>{if(o.userData.deviceIndex===0)group=o});let bottom=Infinity;const v=ctx.camera.position.clone();group.traverse(mesh=>{if(!mesh.isMesh||!mesh.visible)return;const a=mesh.geometry.attributes.position;if(!a)return;for(let i=0;i<a.count;i++){v.fromBufferAttribute(a,i).applyMatrix4(mesh.matrixWorld);bottom=Math.min(bottom,v.y)}});return {bottom,ground:window.S.getState().project.environment.groundY}});
 check(id+'-actual-mesh-stays-above-ground',measured.bottom>=measured.ground-.003,measured);await p.screenshot({path:path.join(out,id+'.png'),fullPage:true});
}
await p.getByRole('combobox',{name:'画幅',exact:true}).selectOption('16:9');await p.evaluate(()=>{const s=window.S.getState();s.setDeviceId('procedural-phone');s.setOrientation('portrait');s.setDeviceScale(1);s.setDeviceRotation([0,0,0]);s.setDevicePosition([-1.5,0,0]);s.addDevice();s.setDevicePosition([1.5,0,0]);s.setCameraPosition([0,2.2,6]);s.setCameraTarget([0,-.1,0]);s.selectObject(null);window.__mockup.scene.traverse(o=>{if(o.isDirectionalLight)o.position.set(3.5,6,2)})});await p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(15000));await p.waitForTimeout(250);
const comparison=await p.evaluate(async()=>{const ctx=window.__mockup,s=window.S.getState(),gl=ctx.renderer;const ground=s.project.environment.groundY,point=ctx.camera.position.clone().set(1.1,ground,-.3).project(ctx.camera),rect=gl.domElement.getBoundingClientRect(),x=Math.max(0,Math.round((point.x+1)*rect.width/2-85)),y=Math.max(0,Math.round((1-point.y)*rect.height/2-30));const read=()=>{const canvas=new OffscreenCanvas(Math.round(rect.width),Math.round(rect.height)),c=canvas.getContext('2d');c.drawImage(gl.domElement,0,0,canvas.width,canvas.height);return Array.from(c.getImageData(x,y,170,60).data)};const before=read();s.setActiveDevice(0);s.setDeviceScale(1.45);s.selectObject(null);await new Promise(r=>setTimeout(r,500));const after=read();let changed=0,error=0;for(let i=0;i<before.length;i++){const d=Math.abs(before[i]-after[i]);if(d>2)changed++;error+=d}const shadowPixels=before.filter((v,i)=>i%4===3&&v>0&&v<240).length;return {roi:{x,y,width:170,height:60},shadowPixels,inside:x+170<=rect.width&&y+60<=rect.height,ground,afterGround:window.S.getState().project.environment.groundY,changedFraction:changed/before.length,meanAbsoluteDifference:error/before.length}});
check('separate-device-shadow-patch-stays-stable',comparison.inside&&comparison.shadowPixels>20&&comparison.ground===comparison.afterGround&&comparison.changedFraction<.005,comparison);await p.screenshot({path:path.join(out,'separate-shadows.png'),fullPage:true});check('no-page-errors',!report.pageErrors.length,report.pageErrors);report.status='PASS';
}catch(e){report.status='FAIL';report.error=String(e);await p?.screenshot({path:path.join(out,'failure.png'),fullPage:true}).catch(()=>{});process.exitCode=1}finally{fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));await b?.close();console.log(JSON.stringify(report))}})();
