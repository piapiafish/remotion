:root {
  --bg: #08080a;
  --chrome: #141417;
  --chrome-2: #1a1a1e;
  --panel: #121215;
  --line: #232328;
  --line-soft: #1c1c20;
  --text: #ececf0;
  --text-2: #9a9aa4;
  --text-3: #6e6e78;
  --accent: #f0562d;
  --accent-soft: rgba(240, 86, 45, 0.16);
  --blue: #3d7dff;
  --radius: 8px;
}

* {
  box-sizing: border-box;
}

.app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
  font-size: 13px;
  overflow: hidden;
}

/* ---------------------------------------------------------------- top bar */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 52px;
  padding: 0 12px;
  background: var(--bg);
  flex-shrink: 0;
  gap: 12px;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.icon-cluster {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--chrome);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px 6px;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  background: transparent;
  border: none;
  border-radius: 999px;
  color: var(--text-2);
  cursor: pointer;
  transition: background 0.12s, color 0.12s;
}

.icon-btn:hover:not(:disabled) {
  background: var(--chrome-2);
  color: var(--text);
}

.icon-btn:disabled {
  opacity: 0.3;
  cursor: default;
}

.project-name {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text);
  font-size: 14px;
  font-weight: 500;
  padding: 6px 8px;
  border-radius: 6px;
  width: 200px;
  font-family: inherit;
}

.project-name:hover {
  border-color: var(--line);
}

.project-name:focus {
  outline: none;
  border-color: var(--blue);
  background: var(--chrome);
}

/* ------------------------------------------------------------- segmented */

.segmented {
  display: inline-flex;
  background: var(--chrome);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 3px;
  gap: 2px;
}

.segment {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  color: var(--text-2);
  border-radius: 999px;
  padding: 6px 14px;
  font-size: 12.5px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.12s, color 0.12s;
}

.segment:hover {
  color: var(--text);
}

.segment.active {
  background: var(--chrome-2);
  color: var(--text);
  box-shadow: inset 0 0 0 1px var(--line);
}

.segmented-sm {
  padding: 2px;
}

.segmented-sm .segment {
  padding: 4px 9px;
}

.segmented-sm .segment.active {
  background: var(--blue);
  color: #fff;
  box-shadow: none;
}

/* ---------------------------------------------------------------- layout */

.app-body {
  flex: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 316px;
  min-height: 0;
}

.stage-zone {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: 1fr;
  min-height: 0;
  min-width: 0;
}

.stage-zone.with-timeline {
  grid-template-rows: minmax(160px, 1fr) 300px;
}

.stage-zone.with-timeline:has(.has-motion-plan) {
  grid-template-rows: minmax(180px, 1fr) 300px;
}

/* -------------------------------------------------------------- artboard */

.artboard-zone {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 0 20px 16px;
}

.artboard-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  height: 30px;
  font-size: 11.5px;
  color: var(--text-3);
  flex-shrink: 0;
}

.artboard-label strong {
  color: var(--text-2);
  font-weight: 600;
  margin-left: 3px;
}

.artboard-dims {
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.artboard-wrap {
  flex: 1;
  display: grid;
  place-items: center;
  min-height: 0;
  overflow: hidden;
}

/* Width and height come from useLetterbox as explicit pixels — see the
   comment there for why this isn't done in CSS. */
.artboard {
  border-radius: 10px;
  overflow: hidden;
  position: relative;
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.5);
}

.artboard canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

.canvas-tools {
  position: absolute;
  bottom: 26px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 2px;
  background: rgba(30, 30, 34, 0.82);
  backdrop-filter: blur(12px);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 5px;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 30px;
  background: transparent;
  border: none;
  border-radius: 999px;
  color: var(--text-2);
  cursor: pointer;
}

.tool-btn.active,
.tool-btn:hover {
  background: rgba(255, 255, 255, 0.09);
  color: var(--text);
}

/* -------------------------------------------------------------- timeline */

.timeline {
  border-top: 1px solid var(--line);
  background: var(--chrome);
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
}

.timeline-toolbar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 16px;
  border-bottom: 1px solid var(--line-soft);
  flex-shrink: 0;
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  background: transparent;
  border: none;
  color: var(--text);
  cursor: pointer;
  border-radius: 6px;
}

.play-btn:hover {
  background: var(--chrome-2);
}

.add-animation {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--text-2);
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 5px 10px;
  cursor: pointer;
}

.add-animation select {
  color-scheme: dark;
  background: transparent;
  border: none;
  color: var(--text);
  font-size: 12.5px;
  font-family: inherit;
  cursor: pointer;
  padding: 0;
  width: auto;
  outline: none;
}

/* Native popup options need their own opaque colours on Windows. */
.add-animation select option {
  background-color: var(--chrome-2);
  color: var(--text);
}

.add-animation select:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 3px;
}

.time-readout {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: auto;
  font-size: 12px;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}

.time-now {
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 4px 9px;
  color: var(--text);
  min-width: 62px;
  text-align: center;
}

.time-duration {
  width: 58px;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 4px 8px;
  color: var(--text);
  font-family: inherit;
  font-size: 12px;
}

.timeline-body {
  --track-label-width: 90px;
  --track-gap: 10px;
  flex: 1;
  padding: 0 16px 12px;
  min-height: 0;
  overflow-y: auto;
}

.ruler {
  position: relative;
  height: 22px;
  margin-left: calc(var(--track-label-width) + var(--track-gap));
  border-bottom: 1px solid var(--line-soft);
}

.tick {
  position: absolute;
  top: 5px;
  transform: translateX(-50%);
  font-size: 10px;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.tracks {
  position: relative;
  padding-top: 10px;
  cursor: pointer;
}

.ruler,
.tracks {
  touch-action: none;
  user-select: none;
}

.tracks:focus-visible {
  outline: 1px solid var(--blue);
  outline-offset: 2px;
}

.track-row {
  display: flex;
  align-items: center;
  gap: var(--track-gap);
  height: 34px;
}

.track-label {
  width: var(--track-label-width);
  flex-shrink: 0;
  font-size: 11.5px;
  color: var(--text-2);
}

.track-lane {
  position: relative;
  flex: 1;
  height: 24px;
  border-radius: 5px;
  background: var(--chrome-2);
  border: 1px solid var(--line-soft);
}

.track-lane.animated {
  background: #23242b;
  border-color: #303240;
}

.keyframe {
  position: absolute;
  top: 50%;
  width: 9px;
  height: 9px;
  margin-left: -4.5px;
  background: var(--blue);
  transform: translateY(-50%) rotate(45deg);
  border-radius: 1.5px;
  padding: 0;
  border: 0;
  cursor: pointer;
}

.playhead-track {
  position: absolute;
  top: 0;
  bottom: 0;
  left: calc(var(--track-label-width) + var(--track-gap));
  right: 0;
  pointer-events: none;
}

.playhead {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  background: var(--accent);
  pointer-events: none;
}

.playhead-grip {
  position: absolute;
  top: -4px;
  left: 50%;
  transform: translateX(-50%);
  width: 9px;
  height: 9px;
  border-radius: 2px;
  background: var(--accent);
}

/* ------------------------------------------------------------ inspector */

.panel {
  overflow-y: auto;
  border-left: 1px solid var(--line);
  background: var(--panel);
  display: flex;
  flex-direction: column;
}

.section {
  border-bottom: 1px solid var(--line-soft);
}

.section-header {
  display: flex;
  align-items: center;
  padding-right: 8px;
}

.section-toggle {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 9px;
  background: transparent;
  border: none;
  color: var(--text);
  padding: 14px 14px;
  font-size: 12.5px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  text-align: left;
}

.section-icon {
  display: flex;
  color: var(--text-3);
}

.section-chevron {
  background: transparent;
  border: none;
  color: var(--text-3);
  cursor: pointer;
  display: flex;
  padding: 4px;
}

.chevron {
  transition: transform 0.15s ease;
}

.chevron.open {
  transform: rotate(180deg);
}

.chevron.right {
  transform: rotate(-90deg);
}

.section-body {
  padding: 0 14px 18px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.subsection {
  border-top: 1px solid var(--line-soft);
  padding-top: 12px;
}

.subsection-header {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  color: var(--text-2);
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
  padding: 0;
}

.subsection-body {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-top: 12px;
}

/* --------------------------------------------------------- number fields */

.field-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: -8px;
}

.numfield {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.numfield-box {
  position: relative;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 7px 8px;
  text-align: center;
  cursor: ew-resize;
  user-select: none;
  font-variant-numeric: tabular-nums;
  font-size: 12.5px;
}

.numfield-box:hover {
  border-color: #34343c;
}

.numfield-box.dragging {
  border-color: var(--blue);
  background: #1e2230;
}

.numfield-input {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  text-align: center;
  font-family: inherit;
  font-size: 12.5px;
  padding: 0;
}

.numfield-key {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 5px;
  height: 5px;
  background: var(--blue);
  transform: rotate(45deg);
}

.numfield-label {
  font-size: 10.5px;
  color: var(--text-3);
  text-align: center;
}

/* ----------------------------------------------------------------- dial */

.dial-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.dial-caption {
  font-size: 12px;
  color: var(--text-2);
}

.dial {
  display: flex;
  gap: 3px;
}

.dial-btn {
  width: 26px;
  height: 26px;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--text-2);
  cursor: pointer;
  font-size: 13px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dial-btn:hover {
  color: var(--text);
  border-color: #3a3a44;
}

.dial-btn.active {
  background: var(--blue);
  border-color: var(--blue);
  color: #fff;
}

/* --------------------------------------------------------- device card */

.device-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 12px;
}

.device-open {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  background: transparent;
  border: none;
  padding: 0;
  color: var(--text);
  font-family: inherit;
  cursor: pointer;
  text-align: left;
}

.device-open:hover .device-thumb {
  color: var(--text);
  border-color: var(--blue);
}

.device-open .chevron {
  margin-left: auto;
  color: var(--text-3);
  flex-shrink: 0;
}

.device-thumb {
  width: 44px;
  height: 54px;
  border-radius: 6px;
  background: #0f0f12;
  border: 1px solid var(--line);
  color: var(--text-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: border-color 0.12s, color 0.12s;
}

.device-name {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 13px;
  font-weight: 600;
  min-width: 0;
}

.device-info {
  color: var(--text-3);
}

.device-list {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  z-index: 20;
  background: #1c1c21;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 4px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);
}

.device-option {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  color: var(--text);
  padding: 9px 10px;
  border-radius: 5px;
  font-size: 12.5px;
  font-family: inherit;
  cursor: pointer;
}

.device-option:hover {
  background: #26262d;
}

.device-option.active {
  color: var(--blue);
}

/* ------------------------------------------------------------- controls */

.control-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.control-group > label {
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-3);
  font-weight: 600;
}

.preset-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.preset-grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.preset-btn {
  background: var(--chrome-2);
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 6px;
  padding: 8px;
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
  text-transform: capitalize;
}

.preset-btn:hover {
  border-color: #3a3a44;
}

.preset-btn.active {
  background: var(--blue);
  border-color: var(--blue);
  color: #fff;
}

.dropzone {
  border: 1px dashed #34343e;
  border-radius: var(--radius);
  min-height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 12px;
  color: var(--text-2);
  cursor: pointer;
  overflow: hidden;
  padding: 10px;
  transition: border-color 0.12s, background 0.12s;
}

.dropzone:hover {
  border-color: #45454f;
}

.dropzone.drag-over {
  border-color: var(--blue);
  background: rgba(61, 125, 255, 0.08);
}

.dropzone-preview {
  max-width: 100%;
  max-height: 150px;
  object-fit: contain;
  border-radius: 4px;
}

.media-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.link-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: transparent;
  border: none;
  color: var(--text-2);
  font-size: 11px;
  font-family: inherit;
  cursor: pointer;
  padding: 0;
}

.link-btn:hover {
  color: var(--text);
}

.finish-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.finish-option {
  position: relative;
  display: grid;
  grid-template-columns: 24px minmax(0, 1fr) 16px;
  align-items: center;
  gap: 9px;
  width: 100%;
  min-height: 40px;
  padding: 6px 9px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: var(--chrome-2);
  color: var(--text-2);
  font: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.12s, background 0.12s, color 0.12s;
}

.finish-option:hover {
  border-color: #3a3a44;
  color: var(--text);
}

.finish-option:focus-within {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}

.finish-radio {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.finish-option.active {
  border-color: var(--blue);
  background: rgba(61, 125, 255, 0.09);
  color: var(--text);
}

.finish-swatch {
  width: 22px;
  height: 22px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.22);
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.38);
}

.finish-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.finish-check {
  opacity: 0;
  color: var(--blue);
}

.finish-option.active .finish-check {
  opacity: 1;
}

.slider-row {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.slider-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11.5px;
}

.slider-label {
  color: var(--text-2);
}

.slider-value {
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.hint {
  font-size: 11px;
  color: var(--text-3);
  line-height: 1.5;
  margin: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.row input[type='number'] {
  width: 100%;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 6px;
  padding: 7px 8px;
  font-family: inherit;
  font-size: 12.5px;
}

select {
  background: var(--chrome-2);
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 6px;
  padding: 7px 8px;
  width: 100%;
  font-family: inherit;
  font-size: 12.5px;
}

input[type='range'] {
  width: 100%;
  accent-color: var(--blue);
}

input[type='color'] {
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 6px;
  width: 36px;
  height: 28px;
  padding: 2px;
  cursor: pointer;
}

.export-btn {
  background: var(--blue);
  border: none;
  color: #fff;
  border-radius: 7px;
  padding: 11px;
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
}

.export-btn:hover {
  background: #4a86ff;
}

.export-btn:disabled {
  opacity: 0.55;
  cursor: default;
}

/* Frame-by-frame exports take tens of seconds, so they get a real progress
   bar rather than a disabled button that looks like the app has hung. */
.export-progress {
  height: 4px;
  border-radius: 2px;
  background: var(--line);
  overflow: hidden;
}

.export-progress-bar {
  height: 100%;
  background: var(--blue);
  transition: width 120ms linear;
}

/* Secondary action inside a control group — reads as a suggestion, not a
   second primary button competing with Export. */
.ghost-btn {
  background: transparent;
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 6px;
  padding: 7px 10px;
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
  width: 100%;
}

.ghost-btn:hover {
  background: var(--chrome-2);
  border-color: var(--blue);
}

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-thumb {
  background: #2a2a31;
  border-radius: 999px;
  border: 3px solid var(--panel);
}

/* ------------------------------------------------------------- templates */

.tpl-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.tpl-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 9px 6px 8px;
  cursor: pointer;
  font-family: inherit;
  transition: border-color 0.12s, background 0.12s;
}

.tpl-card:hover {
  border-color: var(--blue);
  background: #1e2028;
}

.tpl-preview {
  width: 100%;
  height: 46px;
}

.tpl-preview rect {
  fill: #4a4a55;
  stroke: #6d6d7a;
  stroke-width: 0.6;
}

.tpl-card:hover .tpl-preview rect {
  fill: var(--blue);
  stroke: #7ba5ff;
}

.tpl-name {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text);
}

.tpl-count {
  font-size: 10px;
  color: var(--text-3);
}

/* ----------------------------------------------------------- device list */

.device-rows {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.device-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 7px 8px;
  cursor: pointer;
  font-size: 12px;
}

.device-row:hover {
  border-color: #3a3a44;
}

.device-row.active {
  border-color: var(--blue);
  background: #1b2130;
}

.device-row-index {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  background: #2a2a33;
  color: var(--text-2);
  font-size: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.device-row.active .device-row-index {
  background: var(--blue);
  color: #fff;
}

.device-row-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-row-dot {
  width: 5px;
  height: 5px;
  border-radius: 999px;
  background: #4ea86b;
  flex-shrink: 0;
}

.device-row-btn {
  background: transparent;
  border: none;
  color: var(--text-3);
  cursor: pointer;
  padding: 2px;
  display: flex;
  border-radius: 4px;
}

.device-row-btn:hover {
  color: var(--text);
  background: #2c2c36;
}

.device-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  background: transparent;
  border: 1px dashed #3a3a44;
  border-radius: 6px;
  color: var(--text-2);
  padding: 8px;
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
}

.device-add:hover {
  border-color: var(--blue);
  color: var(--text);
}

/* Local storyboard import/save/render, inside the existing inspector. */
.agent-panel {
  display: grid;
  gap: 10px;
  min-width: 0;
}

.agent-panel label,
.agent-panel summary {
  font-size: 12px;
}

.agent-panel summary {
  cursor: pointer;
}

.agent-panel details > .agent-panel {
  padding-top: 10px;
}

.agent-panel textarea,
.agent-panel input:not([type='file']),
.agent-panel select {
  color-scheme: dark;
  width: 100%;
  background: var(--chrome-2);
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--text);
  padding: 8px;
  font: inherit;
  min-width: 0;
}

.agent-panel select option {
  background: var(--chrome-2);
  color: var(--text);
}

.agent-panel textarea {
  resize: vertical;
}

.agent-panel input[type='file'] {
  max-width: 100%;
  font-size: 11px;
}

.agent-panel progress,
.agent-video {
  width: 100%;
}

.agent-video {
  max-height: 300px;
}

.agent-saved {
  border-top: 1px solid var(--line);
  padding-top: 12px;
}

.agent-shots {
  margin: 0;
  padding-left: 20px;
  font-size: 11px;
  line-height: 1.7;
}

.agent-error,
.agent-status {
  margin: 0;
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.agent-error {
  color: #ffb5b5;
}

.agent-status,
.agent-panel a {
  color: #b8d2ff;
}

.agent-panel pre {
  max-height: 240px;
  overflow: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 10px;
}

.motion-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.motion-badge {
  color: #b8d2ff;
  background: #1d2c49;
  border-radius: 4px;
  padding: 3px 6px;
  font-size: 10px;
}

.motion-generate,
.motion-clear,
.motion-applied .ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.motion-applied {
  background: #18202c;
  border: 1px solid #2b3b55;
  border-radius: 6px;
  padding: 10px;
}

.motion-clear:disabled {
  opacity: 0.4;
  cursor: default;
}

.motion-import,
.motion-legacy {
  border-top: 1px solid var(--line);
  padding-top: 12px;
}

.has-motion-plan .timeline-body {
  overflow: auto;
}

.has-motion-plan .timeline-content {
  padding: 0 10px;
}

.motion-filmstrip {
  display: flex;
  gap: var(--track-gap);
  align-items: flex-start;
  padding-top: 6px;
  height: 131px;
}

.motion-frame-lane {
  flex: 1;
  position: relative;
  height: 122px;
}

.motion-frame {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 3px;
  width: 80px;
  height: 120px;
  padding: 4px;
  transform: translateX(-50%);
  background: var(--chrome-2);
  border: 1px solid #34343e;
  border-radius: 5px;
  color: var(--text-2);
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.motion-frame:hover,
.motion-frame:focus-visible {
  border-color: var(--blue);
  color: var(--text);
}

.motion-frame.selected {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}

.motion-frame-time {
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}

.motion-frame.is-key .motion-frame-time {
  color: #a9c8ff;
}

.motion-frame-image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70px;
  height: 58px;
  border-radius: 3px;
  overflow: hidden;
  flex-shrink: 0;
  font-size: 9px;
}

.motion-frame-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.motion-frame-description {
  font-size: 10px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.motion-now {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 6px 16px;
  border-top: 1px solid var(--line);
  font-size: 11px;
  min-height: 32px;
}

.motion-now > span:first-child {
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

.motion-now .hint {
  margin-left: auto;
}

/* Channel editing shares the existing timeline and theme. */
.key-editor { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; padding: 6px 16px; border-bottom: 1px solid var(--line-soft); font-size: 11px; }
.key-editor label { display: flex; align-items: center; gap: 4px; }
.key-editor input { width: 62px; }
.key-editor select, .key-editor button, .key-editor input, .preset-controls input, .preset-controls button {
  color-scheme: dark; background: var(--chrome-2); color: var(--text); border: 1px solid var(--line); border-radius: 4px; padding: 4px; font: inherit;
}
.key-editor select option { background: #25262d; color: #eee; }
.timeline-owner { font-size: 11px; color: var(--text-2); padding: 4px 16px; }
.keyframe.selected { background: var(--accent); outline: 2px solid white; z-index: 2; }
.track-label { background: none; border: 0; padding: 0; text-align: left; cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.time-now { width: 76px; }
.preset-controls { display: flex; gap: 5px; align-items: center; flex-wrap: wrap; font-size: 11px; }
.preset-controls input { width: 48px; }
.timeline-toolbar { flex-wrap: wrap; gap: 8px; padding-top: 6px; padding-bottom: 6px; }

.key-editor select { width: auto; max-width: 160px; }
.canvas-tools { gap: 4px; }
.canvas-tools .tool-btn { width: auto; min-width: 38px; padding: 0 8px; font-size: 11px; }

.project-feedback{display:flex;align-items:center;gap:10px;padding:8px 16px;font-size:12px;background:#24344b;color:#e2eaff;flex-wrap:wrap}
.project-feedback.error{background:#442a2d;color:#ffe4e5}
.project-feedback>span{flex:1}.project-feedback button{padding:3px 8px;cursor:pointer}
.save-state{font-size:11px;color:#a4adbb;white-space:nowrap}
.video-timing-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.video-timing-field{display:flex;flex-direction:column;gap:4px;font-size:11px;min-width:0}
.video-timing-field input{width:100%;box-sizing:border-box;padding:6px;color:inherit;background:#20252f;border:1px solid #434957;border-radius:4px}
.video-timing input[type=checkbox]{width:auto;margin-right:6px}

/* Beginner workflow: template entry, object inspector and shared timeline. */
.beginner-studio { font-family: 'Microsoft YaHei', 'PingFang SC', system-ui, sans-serif; }
.beginner-studio button { font-family: inherit; }
.beginner-studio .topbar { min-height: 58px; gap: 12px; padding: 0 20px; }
.beginner-studio .topbar-left,.beginner-studio .topbar-right { gap: 10px; }
.beginner-studio .project-name { max-width: 170px; }
.beginner-studio .app-body { grid-template-columns: minmax(0,1fr) 330px; flex: 1; min-height:0; }
.beginner-studio .stage-zone.with-timeline { grid-template-rows: minmax(180px,1fr) 260px; }
.beginner-studio .artboard-zone { min-height:0; padding: 10px 20px 0; }
.beginner-studio .artboard-wrap { min-height:0; }
.beginner-studio .artboard { position:relative; overflow:hidden; }
.beginner-studio .panel { width:auto; min-width:0; overflow:hidden; display:flex; flex-direction:column; padding:0; }
.panel-tabs { display:flex; padding:10px 14px; gap:8px; border-bottom:1px solid var(--line); }
.panel-tabs button { flex:1; border:0; background:transparent; color:var(--text-2); padding:10px; border-radius:8px; cursor:pointer; }
.panel-tabs button[aria-selected=true] { color:var(--text); background:var(--chrome-2); }
.panel-content { overflow:auto; padding:16px; flex:1; }
.primary-btn { border:1px solid var(--accent); background:var(--accent); color:white; padding:8px 15px; border-radius:7px; font-size:12px; display:inline-flex; align-items:center; gap:5px; cursor:pointer; white-space:nowrap; }
.beginner-studio .ghost-btn { display:inline-flex; align-items:center; justify-content:center; gap:6px; white-space:nowrap; }
.beginner-studio input:not([type=range]):not([type=checkbox]):not([type=color]):not([type=radio]), .beginner-studio textarea,.beginner-studio select { border:1px solid var(--line); border-radius:6px; background:var(--chrome-2); color:var(--text); padding:7px 8px; font-family:inherit; min-width:0; }
.beginner-studio select { font-size:12px; }
.beginner-studio textarea { resize:vertical; width:100%; line-height:1.6; }
.stack-field { display:flex; flex-direction:column; gap:7px; font-size:12px; color:var(--text-2); min-width:0; margin:10px 0; }
.stack-field input,.stack-field select { width:100%; }
.object-add { display:flex; gap:8px; margin-bottom:14px; }.object-add button { flex:1; }
.object-list { display:flex; flex-direction:column; gap:7px; max-height:230px; overflow:auto; padding:2px; }
.object-card { width:100%; display:flex; gap:10px; align-items:center; padding:10px; text-align:left; background:var(--chrome); border:1px solid var(--line); border-radius:9px; color:var(--text); cursor:pointer; }
.object-card.active { border-color:var(--accent); background:var(--accent-soft); }
.object-card>span:nth-child(2) { flex:1; min-width:0; }.object-card strong { display:block; font-size:12px; }.object-card small { display:block; color:var(--text-2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:195px; margin-top:5px; font-size:10px; }
.object-avatar { width:32px; height:39px; display:grid; place-items:center; color:var(--text-2); flex-shrink:0; }.object-avatar img { width:23px; height:38px; object-fit:cover; border-radius:3px; }
.object-settings { margin-top:18px; padding-top:16px; border-top:1px solid var(--line); }.object-settings .field-header { font-size:12px; gap:6px; }.object-settings .control-group { margin:12px 0; }
.advanced,.environment-group { border-top:1px solid var(--line); margin-top:16px; padding-top:13px; font-size:12px; }.advanced summary,.environment-group summary { cursor:pointer; color:var(--text-2); margin-bottom:12px; }.environment-group:first-child { margin-top:0; border:0; }.environment-group summary { color:var(--text); font-size:13px; font-weight:600; }
.toggle-row { display:flex; align-items:center; gap:9px; font-size:12px; padding:10px 0; }.toggle-row input { accent-color:var(--accent); }
.canvas-tools { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:8px; min-height:42px; }.canvas-tools .hint { margin:0 8px; font-size:10px; }
.template-page { flex:1; overflow:auto; padding:30px max(32px,calc((100vw - 1160px)/2)); background:radial-gradient(ellipse at 45% 0%,#28242c 0%,var(--bg) 65%); }.template-page header { display:flex; align-items:center; justify-content:space-between; gap:20px; }.brand-mark { font-size:15px; font-weight:700; }.template-intro { padding:54px 0 36px; }.eyebrow { color:var(--accent); font-size:12px; letter-spacing:2px; }.template-intro h1 { font-size:32px; margin:14px 0; letter-spacing:-1px; }.template-intro p { color:var(--text-2); line-height:1.8; font-size:14px; }
.template-page .tpl-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }.template-page .tpl-card { padding:20px; min-height:206px; display:flex; flex-direction:column; align-items:flex-start; border-radius:12px; background:#1a191e; gap:7px; transition:transform .16s,border-color .16s; }.template-page .tpl-card:hover { border-color:var(--accent); transform:translateY(-3px); }.template-page .tpl-preview { width:100%; height:86px; margin-bottom:10px; }.template-page .tpl-name { font-size:14px; color:var(--text); }.template-page .tpl-count { color:var(--accent); font-size:10px; }.tpl-description { font-size:11px; color:var(--text-2); line-height:1.6; text-align:left; }.template-page>.hint { margin-top:24px; }
.dialog-shade { position:fixed; inset:0; z-index:100; background:#0009; backdrop-filter:blur(5px); display:flex; justify-content:center; align-items:center; padding:24px; }.studio-dialog { background:var(--panel); border:1px solid var(--line); border-radius:14px; width:520px; max-height:90vh; overflow:auto; padding:24px; box-shadow:0 24px 100px #0008; }.studio-dialog>header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }.studio-dialog h2 { font-size:18px; margin:0; }.studio-dialog>.control-group>.row>label { flex:1; min-width:0; font-size:11px; color:var(--text-2); }.studio-dialog input[type=number] { width:100%; }
.object-timeline { display:flex; flex-direction:column; min-height:0; background:var(--chrome); border-top:1px solid var(--line); }.timeline-mainbar { display:flex; align-items:center; gap:7px; padding:8px 14px; min-height:48px; border-bottom:1px solid var(--line); }.timeline-mainbar label { color:var(--text-2); font-size:11px; white-space:nowrap; }.timeline-mainbar input { width:63px; padding:4px!important; font-size:11px; text-align:center; }.spacer { flex:1; }.timeline-scroll { flex:1; min-height:0; overflow:auto; padding:0 16px 10px 12px; }.timeline-sheet { padding-right:15px; }.time-ruler-wrap { display:flex; align-items:center; height:27px; font-size:10px; color:var(--text-3); }.time-ruler-wrap>span { width:108px; flex-shrink:0; }.time-ruler { flex:1; position:relative; height:100%; cursor:ew-resize; }.time-ruler small { position:absolute; top:7px; transform:translateX(-50%); font-size:9px; pointer-events:none; }.object-track { height:38px; display:flex; align-items:center; gap:0; }.object-track-name { width:108px; flex-shrink:0; border:0; background:transparent; color:var(--text-2); text-align:left; padding:5px; font-size:11px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer; }.object-track.active .object-track-name { color:var(--accent); }.object-lane { position:relative; height:26px; flex:1; background:var(--chrome-2); border-radius:5px; border:1px solid var(--line); touch-action:none; }.pose-key { position:absolute; top:50%; width:26px; height:26px; padding:0; margin:0; transform:translate(-50%,-50%); border:0; background:transparent; display:grid; place-items:center; cursor:ew-resize; z-index:2; touch-action:none; }.pose-key i { width:11px; height:11px; transform:rotate(45deg); background:#77a5ff; border-radius:2px; box-shadow:0 0 0 2px var(--chrome-2); pointer-events:none; }.pose-key.selected { z-index:3; }.pose-key.selected i { background:var(--accent); box-shadow:0 0 0 2px white; }.pose-key:focus-visible { outline:1px solid white; border-radius:4px; }.object-playhead { position:absolute; top:-3px; bottom:-3px; width:1px; background:var(--accent); pointer-events:none; z-index:4; }.timeline-footer { min-height:36px; display:flex; gap:8px; align-items:center; padding:4px 12px; border-top:1px solid var(--line); font-size:10px; color:var(--text-2); }.timeline-footer input { width:68px; padding:4px!important; font-size:10px; }.timeline-footer select { max-width:130px; padding:4px!important; font-size:10px; }.timeline-footer .hint { margin:0; font-size:10px; }.timeline-footer .link-btn { font-size:10px; }.timeline-empty { padding:20px; }
.text-overlay { position:absolute; inset:0; pointer-events:none; z-index:3; }.text-overlay canvas { position:absolute; inset:0; pointer-events:none; }.text-hit { position:absolute; pointer-events:auto; background:transparent; border:1px solid transparent; padding:0; border-radius:2px; touch-action:none; cursor:move; }.text-hit:hover { border-color:#ffffff55; }.text-hit.selected { border-color:#ff8055; outline:1px dashed #ff805566; }
@media(max-width:1150px) { .beginner-studio .app-body { grid-template-columns:minmax(0,1fr) 290px; }.beginner-studio .topbar { padding:0 12px; }.beginner-studio .project-name { max-width:115px; }.template-page .tpl-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }.timeline-footer { flex-wrap:wrap; }.beginner-studio .stage-zone.with-timeline { grid-template-rows:minmax(160px,1fr) 270px; } }
@media(max-width:850px) { .template-page .tpl-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }.template-intro h1 { font-size:26px; }.beginner-studio .topbar .save-state { display:none; }.beginner-studio .topbar-right>.ghost-btn { padding:6px; }.beginner-studio .app-body { grid-template-columns:minmax(0,1fr) 260px; }.canvas-tools .hint { display:none; } }

.beginner-studio .topbar-left,.beginner-studio .topbar-right { display:flex; align-items:center; flex-direction:row; flex-wrap:nowrap; }
.beginner-studio .topbar .ghost-btn,.beginner-studio .topbar .primary-btn { width:auto; }
.timeline-mainbar>.ghost-btn { width:32px; min-width:32px; padding:5px; }.timeline-footer>.ghost-btn { width:auto; }
.beginner-studio .topbar { flex-shrink:0; }

.object-timeline { position:relative; }.key-properties summary { cursor:pointer; color:var(--text-2); white-space:nowrap; }.key-properties>div { position:absolute; left:12px; bottom:40px; width:245px; max-height:220px; overflow:auto; padding:14px; border:1px solid var(--line); border-radius:8px; background:var(--panel); z-index:15; box-shadow:0 6px 28px #0008; }.key-properties label { display:flex; justify-content:space-between; align-items:center; gap:8px; padding:5px 0; }

.beginner-studio .canvas-tools { position:static; transform:none; align-self:center; flex-shrink:0; max-width:100%; min-height:36px; padding:3px 0; border:0; border-radius:0; background:transparent; backdrop-filter:none; }
.feedback-stack { position:fixed; z-index:160; top:64px; left:50%; transform:translateX(-50%); width:calc(100% - 32px); max-width:680px; display:flex; flex-direction:column; gap:6px; pointer-events:none; }.feedback-stack .project-feedback { margin:0; border:1px solid var(--line); border-radius:8px; pointer-events:auto; box-shadow:0 8px 24px #0005; }
@media(max-height:700px) { .beginner-studio .stage-zone.with-timeline { grid-template-rows:minmax(160px,1fr) 190px; }.timeline-mainbar { min-height:40px; padding:4px 10px; }.timeline-footer { min-height:32px; }.object-track { height:32px; }.canvas-tools .hint { display:none; }.beginner-studio .artboard-zone { padding-top:2px; }.artboard-bar { height:24px; } }
