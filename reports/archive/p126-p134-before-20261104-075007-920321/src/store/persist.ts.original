import { unzipSync, zipSync, strToU8, strFromU8 } from 'fflate'
import { getMedia, putMedia, deleteMedia, pruneMedia } from '../media/storage'
import { createDefaultProject, createDevice } from './defaults'
import type { MediaRef, Project } from './schema'
import { validateInputShape, validateProject } from './projectValidation'
import { inspectMedia } from '../media/inspectMedia'
import { ensureFixedGround } from '../scene/groundPlane'

/**
 * `.mockup` = a zip of project.json plus a media/ folder (§5).
 *
 * The document is the source of truth and stays plain JSON; blobs ride
 * alongside it rather than being inlined, so file size scales with the media
 * rather than 4/3 of it in base64.
 */

const PROJECT_ENTRY = 'project.json'
const MEDIA_PREFIX = 'media/'

export class ProjectOpenCancelled extends Error {}

/** Object URLs are per-session, so they must never be written to disk. */
export function stripRuntimeFields(project: Project): Project {
  const strip = (ref: MediaRef): MediaRef => {
    const { url: _url, missing: _missing, ...rest } = ref
    return rest as MediaRef
  }
  return {
    ...project,
    background: project.background.type === 'image' ? { ...project.background, ref: strip(project.background.ref) } : project.background,
    devices: project.devices.map((device) => {
      if (!device.screen) return device
      return { ...device, screen: strip(device.screen) }
    }),
  }
}

export function mediaRefs(project: Project): MediaRef[] {
  return [...project.devices.flatMap(d => d.screen ? [d.screen] : []), ...(project.background.type === 'image' ? [project.background.ref] : [])]
}

export function projectFingerprint(project: Project): string {
  return JSON.stringify(stripRuntimeFields(project))
}

export function missingMedia(project: Project): string[] {
  return [...project.devices.flatMap((d, i) => d.screen?.missing ? [`设备 ${i + 1}（${d.id}）`] : []), ...(project.background.type === 'image' && project.background.ref.missing ? ['背景图片'] : [])]
}

export async function serializeProject(project: Project): Promise<Blob> {
  validateProject(project)
  const files: Record<string, Uint8Array> = {
    [PROJECT_ENTRY]: strToU8(JSON.stringify(stripRuntimeFields(project), null, 2)),
  }

  for (const ref of mediaRefs(project)) {
    const blob = await getMedia(ref.id)
    if (!blob || !blob.size || ref.missing) throw new Error('素材缺失，无法完整保存。请重新绑定缺失素材或移除对应引用后重试。')
    files[`${MEDIA_PREFIX}${ref.id}`] = new Uint8Array(await blob.arrayBuffer())
  }

  return new Blob([zipSync(files, { level: 6 })], { type: 'application/zip' })
}

export async function deserializeProject(file: Blob, confirmMissing?: (labels: string[]) => boolean): Promise<Project> {
  let entries: Record<string, Uint8Array>
  try { entries = unzipSync(new Uint8Array(await file.arrayBuffer())) }
  catch { throw new Error('文件不是有效的 .mockup ZIP，或文件已损坏。') }
  const raw = entries[PROJECT_ENTRY]
  if (!raw) throw new Error('缺少 project.json，无法打开工程。')
  let input: unknown
  try { input = JSON.parse(strFromU8(raw)) } catch { throw new Error('project.json 不是有效 JSON。') }
  validateInputShape(input)
  const project = migrate(input)
  validateProject(project)
  // Decide before writing any archive media or replacing the live document.
  const absent = (ref: MediaRef) => !entries[`${MEDIA_PREFIX}${ref.id}`]?.length
  const missing = [
    ...project.devices.flatMap((d, i) => d.screen && absent(d.screen) ? [`设备 ${i + 1}（${d.id}）`] : []),
    ...(project.background.type === 'image' && absent(project.background.ref) ? ['背景图片'] : []),
  ]
  if (missing.length && confirmMissing && !confirmMissing(missing)) throw new ProjectOpenCancelled()
  const refs = new Map<string, MediaRef>(), written: string[] = [], urls: string[] = []
  try {
    for (const ref of mediaRefs(project)) {
      if (refs.has(ref.id)) continue
      // The archive is authoritative. Never mask missing archive bytes with
      // an unrelated same-ID blob from this browser's previous project.
      const bytes = entries[`${MEDIA_PREFIX}${ref.id}`]
      if (!bytes?.length) { refs.set(ref.id, { ...ref, url: '', missing: true }); continue }
      const blob = new Blob([new Uint8Array(bytes)])
      const actual = await inspectMedia(blob, ref.kind)
      if (actual.width !== ref.width || actual.height !== ref.height || (ref.kind === 'video' && Math.abs((actual.duration ?? 0) - (ref.duration ?? 0)) > .1)) throw new Error('工程素材的尺寸或时长与记录不符，请检查素材后重试。')
      const existing = await getMedia(ref.id)
      const previous = existing ? new Uint8Array(await existing.arrayBuffer()) : null
      const equal = previous?.length === bytes.length && previous.every((v, i) => v === bytes[i])
      // Same-ID/different-content imports must not overwrite the old project
      // or its undo snapshots, including if a later storage write fails.
      const id = existing && !equal ? crypto.randomUUID() : ref.id
      if (!equal) { written.push(id); await putMedia(id, blob) }
      const url = URL.createObjectURL(blob); urls.push(url)
      const { missing: _missing, ...rest } = ref
      refs.set(ref.id, { ...rest, id, url })
    }
    project.devices = project.devices.map(d => ({ ...d, screen: d.screen ? refs.get(d.screen.id)! : null }))
    if (project.background.type === 'image') project.background = { ...project.background, ref: refs.get(project.background.ref.id)! }
    return project
  } catch (error) {
    urls.forEach(url => URL.revokeObjectURL(url))
    await Promise.allSettled(written.map(deleteMedia))
    throw error
  }
}

/**
 * Bring an older document up to the current shape. Runs on every load, not
 * only when the version differs, so a file written by a half-finished build
 * still opens.
 */
export function migrate(input: unknown): Project {
  const defaults = createDefaultProject()
  if (!input || typeof input !== 'object') return defaults
  const raw = input as Partial<Project>

  return ensureFixedGround({
    ...defaults,
    ...raw,
    version: raw.version === 2 ? 2 : 1,
    output: { ...defaults.output, ...raw.output },
    environment: { ...defaults.environment, ...raw.environment },
    camera: { ...defaults.camera, ...raw.camera, tracks: { ...defaults.camera.tracks, ...raw.camera?.tracks } },
    devices: migrateDevices(raw, defaults),
  })
}

type LegacySingleDevice = {
  device?: Partial<Project['devices'][number]>
  deviceTransform?: Project['devices'][number]['transform']
}

/**
 * Scenes became a list of devices when templates arrived. Files written
 * before that carry a single `device` plus a separate `deviceTransform`, so
 * fold the pair into a one-element list rather than dropping the user's
 * device and screenshot on the floor.
 */
function migrateDevices(raw: Partial<Project>, defaults: Project): Project['devices'] {
  if (Array.isArray(raw.devices) && (raw.devices.length > 0 || raw.version === 2)) {
    return raw.devices.map((device) => ({ ...createDevice(), ...device, transform: { ...createDevice().transform, ...device.transform } }))
  }

  const legacy = raw as LegacySingleDevice
  if (legacy.device) {
    return [
      createDevice({
        ...legacy.device,
        transform: legacy.deviceTransform ?? createDevice().transform,
      }),
    ]
  }

  return defaults.devices
}

export function downloadProject(blob: Blob, name: string) {
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a')
  a.href = url
  a.download = `${name || 'Untitled'}.mockup`
  document.body.appendChild(a)
  try { a.click() } finally { a.remove(); setTimeout(() => URL.revokeObjectURL(url), 30000) }
}

/** Drop stored blobs the project no longer references. */
export function pruneUnreferencedMedia(project: Project) {
  return pruneMedia(mediaRefs(project).map((r) => r.id))
}
