const fs=require('node:fs'),path=require('node:path'),root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT,{chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
(async()=>{let b,p;const report={date:new Date().toISOString(),source:'private/user-latest.mockup (snapshot of user update during implementation)',checks:[],errors:[],status:'RUNNING'};const check=(name,pass,detail)=>{report.checks.push({name,pass,detail});if(!pass)throw Error(name)};try{b=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',args:['--no-sandbox','--enable-webgl','--use-gl=angle','--enable-unsafe-swiftshader']});const context=await b.newContext({viewport:{width:1440,height:1000}});await context.route('**/*',r=>['127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());await context.addInitScript(()=>{window.videos=[];const create=document.createElement.bind(document);document.createElement=(...args)=>{const el=create(...args);if(args[0]==='video')window.videos.push(el);return el}});p=await context.newPage();p.on('pageerror',e=>report.errors.push(String(e)));await p.goto(process.env.STUDIO_URL+'/?automation=1',{waitUntil:'networkidle'});await p.evaluate(async()=>{window.S=(await import('/src/store/project.ts')).useProjectStore;window.V=await import('/src/media/screenVideo.ts')});await p.getByLabel('打开工程文件',{exact:true}).setInputFiles(path.join(root,'reports/current/p119-p125-implementation-20261103/private/user-latest.mockup'));await p.waitForFunction(()=>window.S.getState().editorPage==='editor'&&!window.S.getState().fileBusy);await p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(15000));check('latest-project-opens-with-two-user-videos',await p.evaluate(()=>window.S.getState().project.devices.filter(d=>d.screen?.kind==='video').length===2));
await p.evaluate(()=>{window.frames=[];for(const [index,el]of window.videos.filter(el=>el.getAttribute('src')&&el.readyState>=2).entries()){const cb=(now,m)=>{window.frames.push({index,now,time:m.mediaTime});el.requestVideoFrameCallback(cb)};el.requestVideoFrameCallback(cb)}});await p.getByRole('button',{name:'播放',exact:true}).click();await p.waitForTimeout(12000);await p.getByRole('button',{name:'暂停',exact:true}).click();report.playback=await p.evaluate(()=>({frames:window.frames,status:window.V.screenVideoStatus(),time:window.S.getState().playhead}));const groups=Object.values(Object.groupBy(report.playback.frames,f=>f.index));check('both-high-frame-rate-videos-present-frames',groups.length===2&&groups.every(g=>g.length>30),groups.map(g=>g.length));check('latest-user-footage-keeps-forward-frame-order',groups.every(g=>g.every((f,i)=>!i||f.time>=g[i-1].time-.02)));check('latest-user-footage-has-bounded-corrections',report.playback.status.every(v=>v.corrections<10),report.playback.status);await p.screenshot({path:path.join(out,'latest-project.png'),fullPage:true});check('no-page-errors',!report.errors.length,report.errors);report.status='PASS';
}catch(e){report.status='FAIL';report.error=String(e);process.exitCode=1}finally{fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));await b?.close();console.log(JSON.stringify({status:report.status,checks:report.checks}))}})();
