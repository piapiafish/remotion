const fs=require('node:fs'),path=require('node:path'),root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT,{chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
(async()=>{let b;const report={date:new Date().toISOString(),method:'Actual high-frame-rate decoder, controlled +0.25s clock drift followed by a 200ms scheduling gap; this is not a claim that the user naturally reproduced the same trigger.',checks:[],status:'RUNNING'};try{b=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe'});const p=await b.newPage();await p.goto(process.env.STUDIO_URL,{waitUntil:'networkidle'});for(const mode of ['before','after']){report[mode]=await p.evaluate(async mode=>{const V=await import('/src/media/screenVideo.ts'),entry=V.createScreenVideo('/reports/current/p119-p125-implementation-20261103/private/user-recording.mp4',18.084467,{capabilities:{getMaxAnisotropy:()=>1}}),el=entry.el;
await new Promise((resolve,reject)=>{if(el.readyState>=2)return resolve();el.addEventListener('loadeddata',resolve,{once:true});el.addEventListener('error',reject,{once:true})});
const d=Object.getOwnPropertyDescriptor(HTMLMediaElement.prototype,'currentTime'),seeks=[],frames=[];let injecting=false,done=false,injected=false,skipUntil=0;const start=performance.now();
Object.defineProperty(el,'currentTime',{get(){return d.get.call(this)},set(value){seeks.push({at:(performance.now()-start)/1000,from:d.get.call(this),to:value,kind:injecting?'injected':'correction'});d.set.call(this,value)}});
const frame=(now,m)=>{frames.push({at:(now-start)/1000,time:m.mediaTime});if(!done)el.requestVideoFrameCallback(frame)};el.requestVideoFrameCallback(frame);await el.play();
await new Promise(resolve=>{const tick=now=>{const t=(now-start)/1000;if(t>=5.5){done=true;el.pause();resolve();return}if(t>2&&!injected){injected=true;injecting=true;el.currentTime=t+.25;injecting=false;skipUntil=now+200}if(now>=skipUntil){if(mode==='before'){if(Math.abs(el.currentTime-t)>.12)el.currentTime=t;if(el.paused)void el.play()}else V.syncScreenVideos(t,true)}requestAnimationFrame(tick)};requestAnimationFrame(tick)});
const result={seeks,backwardCorrections:seeks.filter(s=>s.kind==='correction'&&s.to<s.from-.05).length,backwardFrames:frames.filter((f,i)=>i&&f.time<frames[i-1].time-.05).length,frames};entry.dispose();return result},mode)}
report.checks=[{name:'old-hard-correction-replays-decoded-frames',pass:report.before.backwardCorrections>0&&report.before.backwardFrames>0},{name:'new-soft-correction-keeps-decoder-moving-forwards',pass:report.after.backwardCorrections===0&&report.after.backwardFrames===0}];report.status=report.checks.every(c=>c.pass)?'PASS':'FAIL';if(report.status!=='PASS')process.exitCode=1;
}catch(e){report.status='FAIL';report.error=String(e);process.exitCode=1}finally{fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));await b?.close();console.log(JSON.stringify({status:report.status,checks:report.checks}))}})();
