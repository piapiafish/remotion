import { beforeEach, describe, expect, it } from 'vitest'
import { createDefaultProject } from '../store/defaults'
import { useProjectStore as store } from '../store/project'
import { emptyHistory, resetCoalescing } from '../store/history'
import { addObjectKey, moveObjectKey, objectPoses, deleteObjectKey, easeObjectKey, withObjectTracks } from './objectEditing'
import { sampleTimeline, sampleTrack } from './sample'
import { changeDisplayRange, isDisplayed } from './displayRange'
import { videoTimeAt } from '../media/videoTiming'
import { validateProject } from '../store/projectValidation'
import { migrate } from '../store/persist'
import { captureCameraPose, resetCameraSession, useCameraSession } from '../store/cameraSession'
import { useFeedbackStore } from '../store/feedback'
import { focusDistance } from '../scene/sceneEffects'
import type { Project } from '../store/schema'
const initial=()=>createDefaultProject(),target=(p:Project)=>({kind:'device' as const,instanceId:p.devices[0].instanceId})
beforeEach(()=>{resetCameraSession();resetCoalescing();store.setState({project:initial(),history:emptyHistory,playhead:0,keySelection:null,editingGesture:false,playing:false,activeDevice:0})})
describe('object display and media time',()=>{
  it('uses inclusive start and exclusive end without changing default objects',()=>{const range={displayRange:{start:1,end:3}};expect([.99,1,2.99,3].map(t=>isDisplayed(range,t))).toEqual([false,true,true,false]);expect(isDisplayed({},100)).toBe(true)})
  it('hides the sampled phone without changing its authored pose',()=>{const p=initial(),next=changeDisplayRange(p,target(p),{start:1,end:2});expect(sampleTimeline(next,0).devices[0].visible).toBe(false);expect(sampleTimeline(next,1).devices[0].visible).toBe(true);expect(sampleTimeline(next,2).devices[0].visible).toBe(false);expect(next.devices[0].transform).toBe(p.devices[0].transform)})
  it('moves the whole object, its keys and its video together',()=>{let p=initial();p=addObjectKey(p,target(p),0,'a');p=addObjectKey(p,target(p),2,'b');p.devices[0].screenPlayback={in:2,out:5,start:1,loop:false};const moved=changeDisplayRange(p,target(p),{start:2,end:6},2);expect(objectPoses(moved,target(p)).map(k=>k.t)).toEqual([2,4]);expect(moved.devices[0].screenPlayback?.start).toBe(3);expect(moved.devices[0].screenPlayback?.in).toBe(2)})
  it('rejects negative or empty object intervals',()=>{const p=initial();expect(changeDisplayRange(p,target(p),{start:-1,end:2})).toBe(p);expect(changeDisplayRange(p,target(p),{start:2,end:2})).toBe(p)})
  it('keeps hidden keys available after a trim',()=>{const base=initial(),p=addObjectKey(base,target(base),2);const next=changeDisplayRange(p,target(p),{start:0,end:1});expect(next.devices[0].transform).toEqual(p.devices[0].transform)})
  it.each([.25,.5,1,2,4])('maps speed %s through the shared clock',rate=>{const timing={in:2,out:6,start:1,loop:false,rate};expect(videoTimeAt(1+1/rate,10,timing).time).toBeCloseTo(3);expect(videoTimeAt(1+4/rate,10,timing).active).toBe(false);expect(videoTimeAt(1+9/rate,10,timing).time).toBeLessThan(6)})
  it('keeps legacy loops at 1x unless deliberately edited',()=>{const timing={in:4,out:6,start:2,loop:true};expect(videoTimeAt(4,10,timing).time).toBe(4);expect(migrate({...initial(),devices:[{...initial().devices[0],screenPlayback:timing}]}).devices[0].screenPlayback).toEqual(timing)})
})
describe('independent stacked pose identity',()=>{
  function stack(){let p=initial();const t=target(p);p=addObjectKey(p,t,0,'first');p=addObjectKey(p,t,1,'one');p=withObjectTracks(p,t,{...p.devices[0].transform,'position.x':{keys:p.devices[0].transform['position.x'].keys.map(k=>k.poseId==='one'?{...k,v:10}:k)}});p=addObjectKey(p,t,2,'two');return {p:moveObjectKey(p,t,1,2,'one'),t}}
  it('preserves two same-channel poses at the same frame',()=>{const {p,t}=stack();expect(objectPoses(p,t).filter(k=>k.t===2)).toHaveLength(2);expect(p.devices[0].transform['position.x'].keys.filter(k=>k.t===2)).toHaveLength(2)})
  it('uses the upper same-time value for all interpolation',()=>{const {p}=stack();const track=p.devices[0].transform['position.x'];expect(sampleTrack(track,2,0)).toBe(10);expect(sampleTrack(track,1,0)).toBeCloseTo(5);expect(Number.isFinite(sampleTrack({...track,interpolation:'continuous'},1,0))).toBe(true)})
  it('moves only the chosen stacked pose back out',()=>{const {p,t}=stack();const moved=moveObjectKey(p,t,2,3,'one');expect(objectPoses(moved,t).filter(k=>k.t===2).map(k=>k.id)).toEqual(['two']);expect(objectPoses(moved,t).find(k=>k.id==='one')?.t).toBe(3)})
  it('deletes one stacked pose while retaining the other',()=>{const {p,t}=stack();const next=deleteObjectKey(p,t,2,'one');expect(objectPoses(next,t).some(k=>k.id==='two')).toBe(true);expect(objectPoses(next,t).some(k=>k.id==='one')).toBe(false)})
  it('changes easing only on the selected layer',()=>{const {p,t}=stack();const next=easeObjectKey(p,t,2,[.4,0,.6,1],'one');expect(next.devices[0].transform['position.x'].keys.find(k=>k.poseId==='two')?.ease).toEqual([0,0,1,1])})
  it('validates a saved stack and rejects malformed identity metadata',()=>{const {p}=stack();expect(()=>validateProject(p)).not.toThrow();p.devices[0].transform['position.x'].keys[0].order=NaN;expect(()=>validateProject(p)).toThrow()})
  it('extends project and undoes the extension with the key',()=>{const s=store.getState();s.setActiveDevice(0);s.addObjectKey(target(s.project));s.setPlayhead(2);s.addObjectKey(target(s.project));const before=store.getState().project,selection=store.getState().keySelection!;store.getState().beginEditGesture();store.getState().moveTimelineKey(selection,9);store.getState().endEditGesture();expect(store.getState().project.duration).toBe(9);store.getState().undo();expect(store.getState().project).toEqual(before)})
  it('protects the original first pose and shows the reason',()=>{const s=store.getState();s.setActiveDevice(0);s.addObjectKey(target(s.project));const before=store.getState().project;store.getState().deleteTimelineKey();expect(store.getState().project).toBe(before);expect(useFeedbackStore.getState().notice?.message).toContain('首关键帧不可删除')})
})
describe('camera recording is an explicit transaction',()=>{
  it('does not edit animated tracks during ordinary viewing',()=>{const s=store.getState();s.addObjectKey({kind:'camera'});const before=store.getState().project.camera;store.getState().setCameraPosition([2,3,4]);expect(store.getState().project.camera).toBe(before);expect(useCameraSession.getState().view?.position).toEqual([2,3,4])})
  it('locks both object and legacy device selection on the recording page',()=>{store.getState().setEditorPage('camera');store.getState().setActiveDevice(0);store.getState().selectObject(target(store.getState().project));expect(store.getState().activeObject).toBeNull()})
  it('records at frame times and includes stationary holds',()=>{useCameraSession.setState({mode:'recording'});const pose={position:[1,2,3] as [number,number,number],target:[0,0,0] as [number,number,number],fov:30};for(const t of [0,.01,1/30,2/30])captureCameraPose(pose,t,30);expect(useCameraSession.getState().draft['position.x'].keys).toHaveLength(3)})
  it('writes a take once and restores the previous camera in one undo',()=>{const before=store.getState().project;store.getState().setEditorPage('camera');useCameraSession.setState({mode:'recording'});captureCameraPose({position:[0,0,4],target:[0,0,0],fov:30},0,30);captureCameraPose({position:[1,0,4],target:[0,0,0],fov:30},1,30);useCameraSession.setState({mode:'review'});store.getState().applyCameraRecording();expect(store.getState().project.camera.animationEnabled).toBe(true);expect(store.getState().project.devices).toEqual(before.devices);store.getState().undo();expect(store.getState().project).toEqual(before)})
  it('discards a draft without changing the document',()=>{const before=store.getState().project;store.getState().setEditorPage('camera');store.getState().setCameraPosition([2,0,5]);store.getState().setEditorPage('editor');expect(store.getState().project).toBe(before);expect(useCameraSession.getState().mode).toBe('idle')})
})

describe('adjacent safety boundaries',()=>{
  it('edits the chosen lower stack through object controls without changing the upper pose',()=>{const s=store.getState(),t=target(s.project);s.setActiveDevice(0);s.addObjectKey(t);s.setPlayhead(2);s.addObjectKey(t);const lower=store.getState().keySelection!.poseId!;s.addObjectKey(t);const upper=store.getState().keySelection!.poseId!;store.getState().setDevicePosition([10,0,0]);store.getState().selectKey({target:t,channel:'*',t:2,poseId:lower});store.getState().setDevicePosition([3,0,0]);const keys=store.getState().project.devices[0].transform['position.x'].keys;expect(keys.find(k=>k.poseId===lower)?.v).toBe(3);expect(keys.find(k=>k.poseId===upper)?.v).toBe(10)})
  it('can restore the default whole-project display duration',()=>{const s=store.getState(),t=target(s.project);s.setDisplayRange(t,{start:1,end:2});store.getState().setDisplayRange(t,null);store.getState().setDuration(9);expect(isDisplayed(store.getState().project.devices[0],8)).toBe(true)})
  it('uses a stable fallback focus when the focus phone is hidden',()=>{const p=initial();p.devices[0].displayRange={start:1,end:2};p.effects={depthOfField:{enabled:true,focusDevice:p.devices[0].instanceId,distance:7,strength:.5},motionBlur:{enabled:false,strength:.5,samples:2}};expect(focusDistance(p,0)).toBe(7)})
  it('rejects a broken embedded font before replacing a project',()=>{store.getState().addText('solid');const p=store.getState().project;p.texts![0].fontData='{';expect(()=>validateProject(p)).toThrow('字形')})
  it('keeps a version-three text-only project empty of phones after migration',()=>{store.getState().addText();const p={...store.getState().project,version:3 as const,devices:[],output:{width:1080,height:1920}};expect(migrate(p).devices).toEqual([]);expect(migrate(p).output).toEqual(p.output)})
})
