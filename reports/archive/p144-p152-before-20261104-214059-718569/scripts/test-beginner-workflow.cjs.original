const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),{execFileSync}=require('node:child_process');
const root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT,url=process.env.STUDIO_URL;
const {chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
const {unzipSync,strFromU8,zipSync,strToU8}=require(path.join(root,'node_modules/fflate'));
const report={date:new Date().toISOString(),method:'Real local Vite HTTP, Chrome UI, native object actions, portable archives and actual encoded downloads.',checks:[],pageErrors:[],consoleErrors:[],exports:[],status:'RUNNING'};
const write=()=>fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));
const check=(name,ok,detail)=>{report.checks.push({name,status:ok?'PASS':'FAIL',detail});write();console.log((ok?'PASS ':'FAIL ')+name);if(!ok)throw Error(name)};
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
let browser,context,p;
async function session(){context=await browser.newContext({viewport:{width:1440,height:1000},acceptDownloads:true});await context.route('**/*',r=>{const u=new URL(r.request().url());return ['127.0.0.1','localhost'].includes(u.hostname)?r.continue():r.abort()});p=await context.newPage();p.setDefaultTimeout(30000);p.on('pageerror',e=>{report.pageErrors.push(String(e));write()});p.on('console',m=>{if(m.type()==='error'){report.consoleErrors.push({text:m.text(),location:m.location()});write()}});p.on('dialog',d=>d.accept());await p.goto(url+'/?automation=1',{waitUntil:'networkidle'});await p.evaluate(async()=>{window.S=(await import('/src/store/project.ts')).useProjectStore;window.T=await import('/src/timeline/sample.ts');window.F=await import('/src/export/frameRenderer.ts');window.R=await import('/src/export/renderer.ts');window.P=await import('/src/store/persist.ts');window.X=await import('/src/export/session.ts')});}
const state=()=>p.evaluate(()=>JSON.parse(JSON.stringify(window.S.getState().project)));
const ready=()=>p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(12000));
async function time(t){await p.getByRole('spinbutton',{name:'当前时间',exact:true}).fill(String(t));await p.getByRole('spinbutton',{name:'当前时间',exact:true}).press('Tab');}
async function number(label,value){await p.getByRole('button',{name:'调整'+label,exact:true}).press('Enter');const input=p.getByRole('textbox',{name:label,exact:true});await input.fill(String(value));await input.press('Enter');}
async function select(id){await p.getByTestId('object-'+id).click();}
async function settings(){await p.getByRole('tab',{name:'对象',exact:true}).click();}
async function modal(){await p.getByRole('button',{name:'导出',exact:true}).click();await p.getByRole('dialog',{name:'导出作品',exact:true}).waitFor();await p.getByRole('button',{name:'标准',exact:true}).click();}
async function close(){await p.getByRole('button',{name:'关闭面板',exact:true}).click();}
async function video(name){const begin=Date.now(),waiting=p.waitForEvent('download',{timeout:600000});waiting.catch(()=>{});await p.getByRole('button',{name:'导出视频（MP4 (H.264)）',exact:true}).click();const dl=await waiting,file=path.join(out,name+'.mp4');await dl.saveAs(file);const probe=JSON.parse(execFileSync('ffprobe',['-v','error','-select_streams','v:0','-count_frames','-show_streams','-show_format','-of','json',file],{encoding:'utf8'}));fs.writeFileSync(path.join(out,name+'-ffprobe.json'),JSON.stringify(probe,null,2));const result={name,file:path.basename(file),seconds:(Date.now()-begin)/1000,bytes:fs.statSync(file).size,width:probe.streams[0].width,height:probe.streams[0].height,frames:Number(probe.streams[0].nb_read_frames),duration:Number(probe.format.duration)};report.exports.push(result);write();return result;}
async function capture(name,t){const data=await p.evaluate(async t=>{const fx=await import('/src/scene/sceneEffects.ts');await fx.settleEffectPreview();const project=window.S.getState().project,ctx=window.R.getExportContext(),backdrop=await(await import('/src/export/backdrop.ts')).loadBackdrop(project.background),exporter=window.F.beginFrameExport({...ctx,project,width:project.output.width,height:project.output.height,backdrop,quality:'standard'});try{const canvas=await exporter.renderAt(t,ctx.applyAt);const blob=await canvas.convertToBlob({type:'image/png'});return await new Promise(r=>{const f=new FileReader();f.onload=()=>r(f.result);f.readAsDataURL(blob)})}finally{exporter.dispose();backdrop?.dispose?.()}},t);fs.writeFileSync(path.join(out,name+'.png'),Buffer.from(data.split(',')[1],'base64'));}
async function save(name){const waiting=p.waitForEvent('download');await p.getByRole('button',{name:'保存工程',exact:true}).click();const dl=await waiting,file=path.join(out,name+'.mockup');await dl.saveAs(file);const entries=unzipSync(fs.readFileSync(file));return {file,entries,project:JSON.parse(strFromU8(entries['project.json']))};}
async function center(index){return p.evaluate(index=>{const ctx=window.__mockup;let group;ctx.scene.traverse(o=>{if(o.userData.deviceIndex===index)group=o});const point=group.getWorldPosition(ctx.camera.position.clone()).project(ctx.camera),rect=ctx.renderer.domElement.getBoundingClientRect();return {x:rect.x+(point.x+1)*rect.width/2,y:rect.y+(1-point.y)*rect.height/2}},index);}
async function nativeWheel(x,y,dy){await p.mouse.move(x,y);await p.mouse.wheel(0,dy);await p.waitForTimeout(260);}
async function previewPixels(){return p.evaluate(()=>{const c=window.__mockup.renderer.domElement,x=new OffscreenCanvas(c.width,c.height).getContext('2d');x.drawImage(c,0,0);return Array.from(x.getImageData(0,0,c.width,c.height).data).reduce((s,v,i)=>s+(i%4===3?v:0),0)});}
