 check('no-page-exceptions',report.pageErrors.length===0,report.pageErrors);check('no-render-console-errors',report.consoleErrors.length===0,report.consoleErrors);check('vite-server-survived-output-downloads',(await p.request.get(url)).ok());report.status='PASS';write();await context.close();
}catch(e){try{report.diagnostic=await p.evaluate(async()=>{const p=window.S.getState().project,ctx=window.R.getExportContext(),groups=[];ctx.scene.traverse(o=>{if(o.userData.deviceIndex!==undefined){const images=[];o.traverse(m=>{for(const mat of Array.isArray(m.material)?m.material:m.material?[m.material]:[]){const t=mat.uniforms?.map?.value??mat.map;if(t?.isVideoTexture)images.push({url:t.image.src,ready:t.image.readyState,seeking:t.image.seeking,time:t.image.currentTime,error:t.image.error?.message})}});groups.push({index:o.userData.deviceIndex,images})}});let preflight='PASS';try{(await import('/src/export/sceneReady.ts')).assertSceneReady(ctx.scene,p)}catch(e){preflight=String(e)}return {preflight,devices:p.devices.map(d=>({id:d.id,ref:d.screen})),clocks:window.__PROMO_BRIDGE__.videoClocks(),groups}})}catch{}await p?.screenshot({path:path.join(out,'failure.png'),fullPage:true}).catch(()=>{});report.status='FAIL';report.error=e.stack;write();console.error(e);process.exitCode=1}finally{await browser?.close()}})();
