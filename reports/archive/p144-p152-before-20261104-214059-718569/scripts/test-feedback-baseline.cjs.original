const fs=require('node:fs'),path=require('node:path');
const root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT;
const {chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
(async()=>{const browser=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',args:['--no-sandbox','--enable-webgl','--use-gl=angle','--enable-unsafe-swiftshader']});
const report={date:new Date().toISOString(),browser:browser.version(),method:'Baseline diagnosis before changes; reported product failures are preserved.',observations:[],errors:[]};
try{const ctx=await browser.newContext({viewport:{width:1440,height:1000}});await ctx.route('**/*',r=>['127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());
await ctx.addInitScript(()=>{window.auditVideos=[];window.auditSeeks=[];const create=document.createElement.bind(document);document.createElement=function(...args){const el=create(...args);if(args[0]==='video')window.auditVideos.push(el);return el};const d=Object.getOwnPropertyDescriptor(HTMLMediaElement.prototype,'currentTime');Object.defineProperty(HTMLMediaElement.prototype,'currentTime',{...d,set(v){if(this.tagName==='VIDEO')window.auditSeeks.push({at:performance.now(),time:v});d.set.call(this,v)}})});
const p=await ctx.newPage();p.on('pageerror',e=>report.errors.push(String(e)));await p.goto(process.env.STUDIO_URL+'/?automation=1',{waitUntil:'networkidle'});await p.evaluate(async()=>{window.S=(await import('/src/store/project.ts')).useProjectStore;window.G=await import('/src/scene/groundPlane.ts')});
await p.getByLabel('打开工程文件',{exact:true}).setInputFiles(path.join(root,'reports/current/p119-p125-implementation-20261103/private/user-baseline.mockup'));await p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(15000));
const lane=await p.locator('.object-lane').first().boundingBox();await p.mouse.move(lane.x+lane.width*.3,lane.y+lane.height/2);await p.mouse.down();await p.mouse.move(lane.x+lane.width*.8,lane.y+lane.height/2,{steps:15});await p.mouse.up();const t=await p.evaluate(()=>window.S.getState().playhead);report.observations.push({name:'empty-lane-drag',expected:6.4,actual:t,productStatus:Math.abs(t-6.4)<.05?'PASS':'FAIL'});
const floor=await p.evaluate(()=>{const s=window.S.getState(),a=window.G.projectGroundY(s.project);s.setActiveDevice(1);s.setDeviceScale(3.5);const b=window.G.projectGroundY(window.S.getState().project);s.undo();return {before:a,after:b}});report.observations.push({name:'floor-follows-one-device-edit',...floor,productStatus:floor.before===floor.after?'PASS':'FAIL'});
await p.screenshot({path:path.join(out,'baseline-user-scene.png'),fullPage:true});
await p.evaluate(()=>{const s=window.S.getState();s.setPlayhead(0);s.setDuration(18);window.auditSeeks=[];window.auditFrames=[];for(const v of window.auditVideos.filter(v=>v.src)){const cb=(now,m)=>{window.auditFrames.push({now,mediaTime:m.mediaTime,presentedFrames:m.presentedFrames,timeline:window.S.getState().playhead});v.requestVideoFrameCallback(cb)};v.requestVideoFrameCallback(cb)}s.setPlaying(true)});
await p.waitForTimeout(13000);report.playback=await p.evaluate(()=>{window.S.getState().setPlaying(false);return {seeks:window.auditSeeks,frames:window.auditFrames,quality:window.auditVideos.filter(v=>v.src).map(v=>({...v.getVideoPlaybackQuality(),time:v.currentTime})),canvas:{width:window.__mockup.renderer.domElement.width,height:window.__mockup.renderer.domElement.height,dpr:devicePixelRatio},time:window.S.getState().playhead}});
await p.evaluate(()=>{window.confirm=m=>{window.confirmMessage=m;return false};window.S.getState().startTemplate('duo-flat')});report.observations.push({name:'unsaved-dialog',nativeConfirm:await p.evaluate(()=>window.confirmMessage??null),customThreeOptions:await p.getByRole('dialog',{name:'未保存的修改'}).count()});
report.status='DIAGNOSED';}catch(e){report.status='ERROR';report.error=String(e);process.exitCode=1}finally{fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));await browser.close();console.log(JSON.stringify({status:report.status,observations:report.observations,frames:report.playback?.frames.length,seeks:report.playback?.seeks.length}))}})();
