const fs=require('node:fs'),path=require('node:path'),{execFileSync}=require('node:child_process');
const root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT,url=process.env.STUDIO_URL;
const {chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
const {unzipSync,strFromU8}=require(path.join(root,'node_modules/fflate'));
const report={date:new Date().toISOString(),checks:[],scenarios:[],pageErrors:[],consoleErrors:[],status:'RUNNING'};
const write=()=>fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));
function check(name,ok,detail){report.checks.push({name,status:ok?'PASS':'FAIL',detail});write();console.log((ok?'PASS ':'FAIL ')+name);if(!ok)throw Error(name)}
let browser,context,p,delivery=process.env.SECOND_PROJECT;
async function session(){context=await browser.newContext({viewport:{width:1600,height:1080},acceptDownloads:true});await context.route('**/*',r=>['127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());p=await context.newPage();p.setDefaultTimeout(30000);p.on('pageerror',e=>report.pageErrors.push(String(e)));p.on('console',m=>{if(m.type()==='error')report.consoleErrors.push(m.text())});p.on('dialog',d=>d.accept());await p.goto(url+'/?automation=1',{waitUntil:'networkidle'});await p.evaluate(async()=>{window.S=(await import('/src/store/project.ts')).useProjectStore;window.T=await import('/src/timeline/sample.ts');window.O=await import('/src/timeline/objectEditing.ts');window.C=(await import('/src/store/cameraSession.ts')).useCameraSession;window.R=await import('/src/export/renderer.ts');window.F=await import('/src/export/frameRenderer.ts');window.V=await import('/src/media/screenVideo.ts');window.P=await import('/src/store/persist.ts')})}
const state=()=>p.evaluate(()=>JSON.parse(JSON.stringify(window.S.getState().project)));
const ready=()=>p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(20000));
async function init(){await p.getByRole('button',{name:/双机并排/}).first().click();await p.evaluate(()=>{const s=window.S.getState();s.setDuration(4);s.setOutput({width:1920,height:1080});s.setActiveDevice(0);s.renameObject('手机 A');s.setActiveDevice(1);s.renameObject('手机 B');s.setActiveDevice(0)});await ready()}
async function open(file){await p.evaluate(()=>window.S.setState({savedFingerprint:window.P.projectFingerprint(window.S.getState().project)}));await p.getByLabel('打开工程文件',{exact:true}).setInputFiles(file);await p.waitForFunction(()=>window.S.getState().editorPage==='editor'&&!window.S.getState().fileBusy);await ready()}
async function time(t){await p.getByRole('spinbutton',{name:'当前时间',exact:true}).fill(String(t));await p.getByRole('spinbutton',{name:'当前时间',exact:true}).press('Tab');await p.waitForTimeout(100)}
async function number(label,value){await p.getByRole('button',{name:'调整'+label,exact:true}).press('Enter');const input=p.getByRole('textbox',{name:label,exact:true});await input.fill(String(value));await input.press('Enter')}
async function save(name){const pending=p.waitForEvent('download',{timeout:60000});await p.getByRole('button',{name:'保存工程',exact:true}).click();const dl=await pending,file=path.join(out,name+'.mockup');await dl.saveAs(file);return file}
async function drag(locator,dx){const b=await locator.boundingBox();await p.mouse.move(b.x+b.width/2,b.y+b.height/2);await p.mouse.down();await p.mouse.move(b.x+b.width/2+dx,b.y+b.height/2,{steps:12});await p.mouse.up();await p.waitForTimeout(120)}
async function still(name,t){const data=await p.evaluate(async t=>(await import('/src/export/session.ts')).withExportSession(async()=>{const project=window.S.getState().project;await (await import('/src/scene/textOverlay.ts')).waitForTitleFonts(project);await(await import('/src/scene/sceneEffects.ts')).settleEffectPreview();const ctx=window.R.getExportContext(),bg=await(await import('/src/export/backdrop.ts')).loadBackdrop(project.background),e=window.F.beginFrameExport({...ctx,project,backdrop:bg,width:1920,height:1080,quality:'standard'});try{const canvas=await e.renderAt(t,ctx.applyAt),blob=await canvas.convertToBlob({type:'image/png'});return Array.from(new Uint8Array(await blob.arrayBuffer()))}finally{e.dispose();bg?.dispose?.()}}),t);fs.writeFileSync(path.join(out,name+'.png'),Buffer.from(data))}
async function scenario(name,fn){if(process.env.SECOND_SCENARIOS&&!process.env.SECOND_SCENARIOS.split(',').includes(name))return;await session();try{await fn();report.scenarios.push({name,status:'PASS'})}catch(e){report.scenarios.push({name,status:'FAIL',error:String(e)});console.log('SCENARIO FAIL '+name+' '+String(e));await p.screenshot({path:path.join(out,name+'-failed.png'),fullPage:true}).catch(()=>{})}finally{write();await context.close()}}
(async()=>{try{browser=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',args:['--no-sandbox','--enable-webgl','--use-gl=angle','--enable-unsafe-swiftshader']});report.browser=browser.version();
await scenario('timeline',async()=>{await init();await p.evaluate(()=>{const s=window.S.getState(),t={kind:'device',instanceId:s.project.devices[0].instanceId};s.setActiveDevice(0);s.addObjectKey(t);s.setPlayhead(1);s.setDevicePosition([.4,0,0]);s.setPlayhead(2);s.addObjectKey(t)});
 await p.getByRole('button',{name:'手机 A关键帧 1秒',exact:true}).click();await p.keyboard.press('ArrowUp');let selection=await p.evaluate(()=>window.S.getState().keySelection);check('native-click-focus-then-up-one-frame',Math.abs(selection.t-(1+1/30))<1e-6,selection);
 await p.keyboard.down('ArrowUp');for(let i=0;i<100;i++)await p.keyboard.press('ArrowUp');await p.keyboard.up('ArrowUp');selection=await p.evaluate(()=>window.S.getState().keySelection);check('100-nudges-cross-other-keys-without-small-limit',selection.t>4,{t:selection.t});
 const keytime=p.getByRole('spinbutton',{name:'关键帧时间',exact:true});await keytime.fill('9');await keytime.press('Enter');check('precise-retime-extends-project',(await state()).duration===9);await p.getByRole('button',{name:'撤销',exact:true}).click();check('retime-and-extension-undo-together',(await state()).duration<9);await p.getByRole('button',{name:'重做',exact:true}).click();await p.getByRole('button',{name:'手机 A关键帧 9秒',exact:true}).click();
 await p.getByRole('spinbutton',{name:'关键帧时间',exact:true}).fill('2');await p.getByRole('spinbutton',{name:'关键帧时间',exact:true}).press('Enter');const poses=await p.evaluate(()=>window.O.objectPoses(window.S.getState().project,{kind:'device',instanceId:window.S.getState().project.devices[0].instanceId}));check('same-frame-retime-preserves-independent-poses',poses.filter(k=>k.t===2).length===2,poses);
 await p.getByRole('button',{name:'手机 A 2秒叠放2个关键帧',exact:true}).click();await p.getByRole('group',{name:'叠放关键帧',exact:true}).getByRole('button',{name:/下层/}).click();const lower=await p.evaluate(()=>window.S.getState().keySelection.poseId);await p.getByRole('button',{name:'删除关键帧',exact:true}).click();check('deletes-only-selected-stack-layer',await p.evaluate(id=>!window.O.objectPoses(window.S.getState().project,{kind:'device',instanceId:window.S.getState().project.devices[0].instanceId}).some(k=>k.id===id),lower));await p.getByRole('button',{name:'撤销',exact:true}).click();
 await p.getByRole('button',{name:'手机 A关键帧 0秒',exact:true}).click();const before=JSON.stringify(await state());await p.keyboard.press('Delete');check('first-key-protected-with-visible-message',JSON.stringify(await state())===before&&await p.getByText(/首关键帧不可删除/).isVisible());
 await p.screenshot({path:path.join(out,'timeline-stacks.png'),fullPage:true});
});
await scenario('ranges',async()=>{await init();const id=(await state()).devices[0].instanceId;await p.evaluate(id=>{window.S.getState().setDisplayRange({kind:'device',instanceId:id},{start:1,end:3})},id);await time(.5);await p.waitForTimeout(150);check('object-is-hidden-before-appearance',await p.evaluate(()=>{let found;window.R.getExportContext().scene.traverse(o=>{if(o.userData.deviceIndex===0)found=o.visible});return found===false},id));await time(1);check('object-is-visible-at-appearance',await p.evaluate(()=>{let v;window.R.getExportContext().scene.traverse(o=>{if(o.userData.deviceIndex===0)v=o.visible});return v===true}));await time(3);check('object-is-hidden-at-end',await p.evaluate(()=>{let v;window.R.getExportContext().scene.traverse(o=>{if(o.userData.deviceIndex===0)v=o.visible});return v===false}));
 const row=p.getByTestId('track-'+id),before=await state(),lane=await row.locator('.object-lane').boundingBox();await drag(row.getByRole('button',{name:'手机 A出现时间',exact:true}),lane.width/8);let after=await state();check('left-range-handle-trims-without-erasing-keys',after.devices[0].displayRange.start>1.4&&JSON.stringify(after.devices[0].transform)===JSON.stringify(before.devices[0].transform));await drag(row.locator('.display-clip'),lane.width/8);after=await state();check('whole-object-range-moves-authored-keys',after.devices[0].transform['position.x'].keys[0].t>.4);check('range-edit-preserves-other-device',JSON.stringify(after.devices[1])===JSON.stringify(before.devices[1]));await p.getByRole('button',{name:'撤销',exact:true}).click();check('range-move-undo-keeps-previous-trim',(await state()).devices[0].displayRange.start<2);await p.screenshot({path:path.join(out,'object-ranges.png'),fullPage:true});
});
await scenario('media',async()=>{await open(path.join(root,'reports/current/p119-p125-implementation-20261103/regression-30s/beginner-scene.mockup'));await p.evaluate(()=>{const s=window.S.getState();s.setActiveDevice(0);s.renameObject('手机 A');s.setScreenPlayback({in:2,out:5,start:1,loop:false});s.setDisplayRange({kind:'device',instanceId:s.project.devices[0].instanceId},{start:0,end:4})});const d=(await state()).devices[0];await p.getByText('动画调节 · 屏幕视频',{exact:true}).click();await p.getByRole('spinbutton',{name:'播放速度（倍）',exact:true}).fill('2');await p.getByRole('spinbutton',{name:'播放速度（倍）',exact:true}).press('Enter');check('video-speed-setting-is-shared-with-clock',await p.evaluate(()=>{const d=window.S.getState().project.devices[0];return d.screenPlayback.rate===2&&Math.abs(window.V.screenVideoStatus()[0].time-0)>=0}));check('loop-setting-removed',await p.getByRole('checkbox',{name:'循环选定片段'}).count()===0);
 const before=await state(),input=p.getByRole('spinbutton',{name:'在作品第几秒开始',exact:true});await input.fill('-1');await input.press('Enter');check('negative-start-identifies-error-and-preserves-value',(await state()).devices[0].screenPlayback.start===1&&await p.getByText(/作品开始时间不能小于/).isVisible());
 const row=p.getByTestId('track-'+d.instanceId),lane=await row.locator('.object-lane').boundingBox();await drag(row.getByRole('button',{name:'手机 A视频片头',exact:true}),lane.width/(await state()).duration*.25);let after=await state();check('left-video-trim-keeps-its-end-fixed',after.devices[0].screenPlayback.in>2.4&&Math.abs(after.devices[0].screenPlayback.start+(after.devices[0].screenPlayback.out-after.devices[0].screenPlayback.in)/2-2.5)<.05);check('video-trim-does-not-touch-motion',JSON.stringify(after.devices[0].transform)===JSON.stringify(before.devices[0].transform));
 const ids=after.devices.map(x=>x.instanceId);await p.evaluate(ids=>{const s=window.S.getState();s.setActiveDevice(0);s.setDisplayRange({kind:'device',instanceId:ids[0]},{start:0,end:1});s.setActiveDevice(1);s.setDisplayRange({kind:'device',instanceId:ids[1]},{start:2,end:4});s.setPlayhead(6)},ids);await p.waitForTimeout(700);check('inactive-video-decoders-are-released',await p.evaluate(()=>window.V.screenVideoStatus().length===0));await time(.5);await ready();check('video-decoder-restores-on-backward-seek',await p.evaluate(()=>window.V.screenVideoStatus().length===1));
 const future=await p.evaluate(()=>window.__PROMO_BRIDGE__.previewFrame(90));fs.writeFileSync(path.join(out,'bridge-future-frame.png'),Buffer.from(future.split(',')[1],'base64'));check('bridge-preview-wakes-future-visible-video',future.length>2000);
 const memory=[];for(let i=0;i<6;i++){await time(6);await p.waitForTimeout(150);memory.push(await p.evaluate(()=>({decoders:window.V.screenVideoStatus().length,...window.R.getExportContext().renderer.info.memory})));await time(.5);await ready()}
 check('repeated-hide-and-restore-has-bounded-resources',memory.every(m=>m.decoders===0)&&Math.max(...memory.map(m=>m.textures))-Math.min(...memory.map(m=>m.textures))<=2,memory);fs.writeFileSync(path.join(out,'resource-cycles.json'),JSON.stringify(memory,null,2));await p.screenshot({path:path.join(out,'video-clip-controls.png'),fullPage:true});
});
await scenario('camera',async()=>{await open(path.join(root,'reports/current/p119-p125-implementation-20261103/regression-30s/beginner-scene.mockup'));await p.evaluate(()=>{const s=window.S.getState();s.setDuration(4);s.setEffects({depthOfField:{enabled:false,focusDevice:null,distance:3.2,strength:.4},motionBlur:{enabled:false,strength:.5,samples:2}});s.setActiveDevice(0);s.renameObject('手机 A');s.setActiveDevice(1);s.renameObject('手机 B')});await p.evaluate(()=>{const s=window.S.getState();s.selectObject(null);s.addObjectKey({kind:'device',instanceId:s.project.devices[0].instanceId});s.setPlayhead(2);s.setDeviceRotation([0,Math.PI*2,0]);s.setPlayhead(0);s.selectObject(null)});const before=JSON.stringify((await state()).devices);let board=await p.getByTestId('artboard').boundingBox();await p.mouse.click(board.x+15,board.y+15);const originalCamera=JSON.stringify((await state()).camera);await p.keyboard.down('ArrowRight');await p.waitForTimeout(350);await p.keyboard.up('ArrowRight');check('arrow-key-pans-static-camera',JSON.stringify((await state()).camera)!==originalCamera);await p.getByRole('button',{name:'撤销',exact:true}).click();check('keyboard-camera-pan-is-one-undo',JSON.stringify((await state()).camera)===originalCamera);
 await p.getByRole('button',{name:'录制相机运动',exact:true}).click();check('dedicated-recorder-has-no-object-panel',await p.getByRole('heading',{name:'录制相机运动',exact:true}).isVisible()&&await p.getByTestId('object-settings').count()===0);board=await p.getByTestId('artboard').boundingBox();await p.mouse.click(board.x+board.width/2,board.y+board.height/2);check('objects-cannot-be-selected-in-recorder',await p.evaluate(()=>window.S.getState().activeObject===null));
 await p.getByRole('button',{name:'开始录制（3 秒倒计时）',exact:true}).click();await p.waitForTimeout(800);check('countdown-does-not-advance-time',await p.evaluate(()=>window.S.getState().playhead===0));await p.waitForFunction(()=>window.C.getState().mode==='recording');await p.mouse.move(board.x+40,board.y+40);await p.mouse.down();await p.mouse.move(board.x+150,board.y+65,{steps:35});await p.mouse.up();await p.mouse.wheel(0,-120);await p.keyboard.down('ArrowUp');await p.waitForTimeout(600);await p.keyboard.up('ArrowUp');await p.getByRole('button',{name:'结束录制',exact:true}).click();
 const take=await p.evaluate(()=>JSON.parse(JSON.stringify(window.C.getState())));check('continuous-recording-captures-motion-and-holds',take.draft['position.x'].keys.length>15&&new Set(take.draft['position.x'].keys.map(k=>k.v.toFixed(4))).size>5,{frames:take.draft['position.x'].keys.length,start:take.start,end:take.end});check('recording-keeps-object-animation-data',JSON.stringify((await state()).devices)===before);
 await p.getByRole('button',{name:'采用本次录制',exact:true}).click();const recorded=JSON.stringify((await state()).camera);check('take-committed-as-editable-camera-track',(await state()).camera.animationEnabled);await p.getByRole('button',{name:'撤销',exact:true}).click();check('whole-take-undo-restores-camera',JSON.stringify((await state()).camera)===originalCamera);await p.getByRole('button',{name:'重做',exact:true}).click();
 board=await p.getByTestId('artboard').boundingBox();await p.mouse.move(board.x+30,board.y+30);await p.mouse.down();await p.mouse.move(board.x+90,board.y+45,{steps:15});await p.mouse.up();check('ordinary-viewing-does-not-write-recorded-track',JSON.stringify((await state()).camera)===recorded);await p.getByRole('button',{name:/返回成片镜头/}).click();delivery=await save('camera-take');fs.writeFileSync(path.join(out,'camera-take.json'),JSON.stringify(take,null,2));
});
await scenario('text',async()=>{if(delivery)await open(delivery);else await init();await p.getByRole('button',{name:'添加文字',exact:true}).click();await p.getByRole('textbox',{name:'文字内容',exact:true}).fill('手机可以挡住贴纸文字');await p.getByRole('combobox',{name:'文字前后关系',exact:true}).selectOption('back');await number('垂直位置',50);await number('字号',90);check('sticker-can-be-placed-behind-scene',(await state()).texts.at(-1).layer==='back');await p.getByRole('button',{name:'添加实体文字',exact:true}).click();await p.getByRole('textbox',{name:'文字内容',exact:true}).fill('中文 3D');await number('水平位置',0);await number('垂直位置',.3);await number('纵深位置',-.25);await number('文字厚度',.18);await number('偏航角',25);await p.waitForFunction(()=>{let found=false;window.R.getExportContext()?.scene.traverse(o=>{if(o.userData.textId&&o.children.some(x=>x.geometry))found=true});return found},{timeout:30000});await p.evaluate(()=>(import('/src/scene/textOverlay.ts')).then(m=>m.waitForTitleFonts(window.S.getState().project)));
 check('real-solid-text-has-thick-geometry',await p.evaluate(()=>{let result=false;window.R.getExportContext().scene.traverse(o=>{if(o.userData.textId){const mesh=o.children.find(x=>x.geometry);if(mesh){mesh.geometry.computeBoundingBox();result=mesh.geometry.boundingBox.max.z-mesh.geometry.boundingBox.min.z>.9&&mesh.scale.z>.17}}});return result}));
 const solid=(await state()).texts.at(-1);await time(0);await p.getByRole('button',{name:'添加关键帧',exact:true}).click();await time(2);await number('偏航角',205);await number('文字厚度',.3);check('solid-text-pose-and-thickness-are-keyed',(await state()).texts.at(-1).transform.depth.keys.length===2);await still('solid-front',0);await still('solid-side',1);await still('solid-back',2);await p.screenshot({path:path.join(out,'solid-settings-alignment.png'),fullPage:true});
 const layout=await p.locator('.text-settings .field-grid').first().locator('.numfield-box,select,input[type=color]').evaluateAll(els=>els.map(e=>e.getBoundingClientRect().top));check('text-control-inputs-align',Math.max(...layout)-Math.min(...layout)<3,layout);
 await p.evaluate(()=>{const s=window.S.getState();s.setEffects({depthOfField:{enabled:true,focusDevice:s.project.devices[0].instanceId,distance:3.2,strength:.4},motionBlur:{enabled:true,strength:.5,samples:2}})});await still('solid-effects',1);await p.evaluate(()=>{const s=window.S.getState();s.setPlaying(false);const second=s.project.devices[1],solid=s.project.texts.find(t=>t.textKind==='solid');s.setDisplayRange({kind:'device',instanceId:second.instanceId},{start:1,end:3.6});s.setDisplayRange({kind:'text',instanceId:solid.instanceId},{start:.25,end:3.5});s.setActiveDevice(1);s.setScreenPlayback({rate:2});s.selectObject({kind:'text',instanceId:solid.instanceId})});delivery=await save('second-feedback-scene');const saved=JSON.parse(strFromU8(unzipSync(fs.readFileSync(delivery))['project.json']));check('solid-glyph-subset-and-new-timing-are-portable',saved.version===3&&typeof saved.texts.find(t=>t.instanceId===solid.instanceId).fontData==='string'&&JSON.parse(saved.texts.find(t=>t.instanceId===solid.instanceId).fontData).glyphs['中']);
 await context.close();await session();await context.route('**/fonts/**',r=>r.abort());await open(delivery);await p.evaluate(()=>(import('/src/scene/textOverlay.ts')).then(m=>m.waitForTitleFonts(window.S.getState().project)));check('fresh-session-restores-both-text-kinds',JSON.stringify((await state()).texts.map(t=>t.transform))===JSON.stringify(saved.texts.map(t=>t.transform)));await still('restored-solid',1);
});
await scenario('cancel-retry',async()=>{if(!delivery)throw Error('Missing project');await open(delivery);await p.evaluate(()=>window.S.getState().setDuration(30));await p.getByRole('button',{name:'导出',exact:true}).click();await p.getByRole('button',{name:'标准',exact:true}).click();await p.getByRole('button',{name:'导出视频（MP4 (H.264)）',exact:true}).click();await p.getByRole('button',{name:/取消导出/}).click();await p.waitForFunction(async()=>!(await import('/src/export/session.ts')).useExportSession.getState().busy,{timeout:5000});await p.getByText(/已取消导出/).waitFor({timeout:10000});check('cancel-releases-session-during-preparation',await p.getByText(/已取消导出/).isVisible());await p.getByRole('button',{name:'关闭面板',exact:true}).click();await p.evaluate(()=>window.S.getState().setDuration(2));await p.getByRole('button',{name:'导出',exact:true}).click();const waiting=p.waitForEvent('download',{timeout:120000});await p.getByRole('button',{name:'导出视频（MP4 (H.264)）',exact:true}).click();const dl=await waiting,file=path.join(out,'cancel-retry-2s.mp4');await dl.saveAs(file);const probe=JSON.parse(execFileSync('ffprobe',['-v','error','-count_frames','-show_streams','-of','json',file],{encoding:'utf8'}));check('actual-export-retries-after-cancel',Number(probe.streams[0].nb_read_frames)===60);await p.getByRole('button',{name:'关闭面板',exact:true}).click();await p.getByRole('button',{name:'添加文字',exact:true}).click();check('editing-works-after-retried-export',(await state()).texts.length===5)});
await scenario('references',async()=>{if(!delivery)throw Error('Missing project');await open(delivery);for(const n of [0,7,8,29,30,60,104,105,107,108,119])await still('reference-'+String(n).padStart(3,'0'),n/30);check('reference-frames-use-shared-export-session',true)});
await scenario('exports',async()=>{if(!delivery)throw Error('No completed scene available');await open(delivery);await p.getByRole('button',{name:'导出',exact:true}).click();await p.getByRole('button',{name:'标准',exact:true}).click();const wait=p.waitForEvent('download',{timeout:300000});wait.catch(()=>{});await p.getByRole('button',{name:'导出视频（MP4 (H.264)）',exact:true}).click();const dl=await wait,file=path.join(out,'second-feedback-1080p30.mp4');await dl.saveAs(file);const probe=JSON.parse(execFileSync('ffprobe',['-v','error','-count_frames','-show_streams','-show_format','-of','json',file],{encoding:'utf8'}));fs.writeFileSync(path.join(out,'ffprobe-short.json'),JSON.stringify(probe,null,2));check('real-effects-1080p30-video',probe.streams[0].width===1920&&probe.streams[0].height===1080&&Number(probe.streams[0].nb_read_frames)===120);
 await p.getByRole('button',{name:'关闭面板',exact:true}).click();for(const [name,t]of [['reference-000',0],['reference-030',1],['reference-060',2],['reference-090',3]])await still(name,t);
 if(process.env.SECOND_SKIP_LONG!=='1'){await p.evaluate(()=>{const s=window.S.getState(),p=structuredClone(s.project),factor=30/p.duration;const move=tracks=>Object.fromEntries(Object.entries(tracks).map(([c,t])=>[c,{...t,keys:t.keys.map(k=>({...k,t:k.t*factor}))}]));p.duration=30;p.effects.depthOfField.enabled=false;p.effects.motionBlur.enabled=false;p.camera.tracks=move(p.camera.tracks);for(const d of p.devices){d.transform=move(d.transform);if(d.displayRange)d.displayRange={start:d.displayRange.start*factor,end:d.displayRange.end*factor};if(d.screenPlayback)d.screenPlayback.start*=factor}for(const t of p.texts??[]){t.transform=move(t.transform);if(t.displayRange)t.displayRange={start:t.displayRange.start*factor,end:t.displayRange.end*factor}}window.S.setState({project:p,playhead:0,playing:false})});const saved=await save('second-feedback-30s');await p.getByRole('button',{name:'导出',exact:true}).click();const longWait=p.waitForEvent('download',{timeout:420000});longWait.catch(()=>{});await p.getByRole('button',{name:'导出视频（MP4 (H.264)）',exact:true}).click();const long=await longWait,longFile=path.join(out,'second-feedback-30s.mp4');await long.saveAs(longFile);const q=JSON.parse(execFileSync('ffprobe',['-v','error','-count_frames','-show_streams','-show_format','-of','json',longFile],{encoding:'utf8'}));fs.writeFileSync(path.join(out,'ffprobe-long.json'),JSON.stringify(q,null,2));check('single-30-second-900-frame-video',Number(q.streams[0].nb_read_frames)===900,{file:longFile,project:saved})}
});
check('no-unhandled-page-errors',report.pageErrors.length===0,report.pageErrors);check('no-console-errors',report.consoleErrors.length===0,report.consoleErrors);report.status=report.scenarios.every(s=>s.status==='PASS')?'PASS':'FAIL';if(report.status==='FAIL')process.exitCode=1;
}catch(e){report.status='FAIL';report.error=String(e);process.exitCode=1}finally{write();await browser?.close();console.log(JSON.stringify({status:report.status,scenarios:report.scenarios,checks:report.checks.length}))}})();
