const fs=require('node:fs'),path=require('node:path');
const root=path.resolve(__dirname,'..'),out=process.env.BEGINNER_OUT,url=process.env.STUDIO_URL;
const {chromium}=require(path.join(root,'.venv/Lib/site-packages/playwright/driver/package'));
const report={date:new Date().toISOString(),checks:[],scenarios:[],pageErrors:[],consoleErrors:[],status:'RUNNING'};
const write=()=>fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));
function check(name,ok,detail){report.checks.push({name,status:ok?'PASS':'FAIL',detail});write();console.log((ok?'PASS ':'FAIL ')+name);if(!ok)throw Error(name)}
let browser,context,p;
async function session(){context=await browser.newContext({viewport:{width:1600,height:1080},acceptDownloads:true});await context.route('**/*',r=>['127.0.0.1','localhost'].includes(new URL(r.request().url()).hostname)?r.continue():r.abort());p=await context.newPage();p.setDefaultTimeout(30000);p.on('pageerror',e=>report.pageErrors.push(String(e)));p.on('console',m=>{if(m.type()==='error')report.consoleErrors.push(m.text())});p.on('dialog',d=>d.accept());await p.goto(url+'/?automation=1',{waitUntil:'networkidle'});await p.evaluate(async()=>{window.S=(await import('/src/store/project.ts')).useProjectStore;window.T=await import('/src/timeline/sample.ts');window.O=await import('/src/timeline/objectEditing.ts');window.C=(await import('/src/store/cameraSession.ts')).useCameraSession;window.R=await import('/src/export/renderer.ts');window.F=await import('/src/export/frameRenderer.ts');window.V=await import('/src/media/screenVideo.ts');window.P=await import('/src/store/persist.ts')})}
const state=()=>p.evaluate(()=>JSON.parse(JSON.stringify(window.S.getState().project)));
const ready=()=>p.evaluate(()=>window.__PROMO_BRIDGE__.waitForReady(20000));
async function init(){await p.getByRole('button',{name:/双机并排/}).first().click();await p.evaluate(()=>{const s=window.S.getState();s.setDuration(4);s.setOutput({width:1920,height:1080});s.setActiveDevice(0);s.renameObject('手机 A');s.setActiveDevice(1);s.renameObject('手机 B');s.setActiveDevice(0)});await ready()}
async function open(file){await p.evaluate(()=>window.S.setState({savedFingerprint:window.P.projectFingerprint(window.S.getState().project)}));await p.getByLabel('打开工程文件',{exact:true}).setInputFiles(file);await p.waitForFunction(()=>window.S.getState().editorPage==='editor'&&!window.S.getState().fileBusy);await ready()}
async function time(t){await p.getByRole('spinbutton',{name:'当前时间',exact:true}).fill(String(t));await p.getByRole('spinbutton',{name:'当前时间',exact:true}).press('Tab');await p.waitForTimeout(100)}
async function number(label,value){await p.getByRole('button',{name:'调整'+label,exact:true}).press('Enter');const input=p.getByRole('textbox',{name:label,exact:true});await input.fill(String(value));await input.press('Enter')}
async function save(name){const pending=p.waitForEvent('download',{timeout:60000});await p.getByRole('button',{name:'保存工程',exact:true}).click();const dl=await pending,file=path.join(out,name+'.mockup');await dl.saveAs(file);return file}
async function still(name,t){const data=await p.evaluate(async t=>(await import('/src/export/session.ts')).withExportSession(async()=>{const project=window.S.getState().project;await (await import('/src/scene/textOverlay.ts')).waitForTitleFonts(project);await(await import('/src/scene/sceneEffects.ts')).settleEffectPreview();const ctx=window.R.getExportContext(),bg=await(await import('/src/export/backdrop.ts')).loadBackdrop(project.background),e=window.F.beginFrameExport({...ctx,project,backdrop:bg,width:1920,height:1080,quality:'standard'});try{const canvas=await e.renderAt(t,ctx.applyAt),blob=await canvas.convertToBlob({type:'image/png'});return Array.from(new Uint8Array(await blob.arrayBuffer()))}finally{e.dispose();bg?.dispose?.()}}),t);fs.writeFileSync(path.join(out,name+'.png'),Buffer.from(data))}
async function scenario(name,fn){if(process.env.SECOND_SCENARIOS&&!process.env.SECOND_SCENARIOS.split(',').includes(name))return;await session();try{await fn();report.scenarios.push({name,status:'PASS'})}catch(e){report.scenarios.push({name,status:'FAIL',error:String(e)});console.log('SCENARIO FAIL '+name+' '+String(e));await p.screenshot({path:path.join(out,name+'-failed.png'),fullPage:true}).catch(()=>{})}finally{write();await context.close()}}
(async()=>{try{browser=await chromium.launch({headless:true,executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',args:['--no-sandbox','--enable-webgl','--use-gl=angle','--enable-unsafe-swiftshader']});report.browser=browser.version();
await scenario('media-regression',async()=>{await open(path.join(root,'reports/current/p119-p125-implementation-20261103/regression-30s/beginner-scene.mockup'));await p.evaluate(()=>{const s=window.S.getState();s.setDuration(8);s.setEffects({depthOfField:{enabled:false,focusDevice:null,distance:3.2,strength:.4},motionBlur:{enabled:false,strength:.5,samples:2}});s.setActiveDevice(0);s.setScreenPlayback({in:2,out:5,start:1,loop:false,rate:1});s.setActiveDevice(1);s.setScreenPlayback({in:4,out:6,start:2,loop:true,rate:1})});await ready();const results=[];for(const t of [0,2,3,4,5,6]){await time(t);await p.evaluate(t=>window.V.seekScreenVideos(t,5000),t);results.push(await p.evaluate(()=>window.V.screenVideoStatus().map(v=>v.time)))}const expected=[[2,4],[3,4],[4,5],[5,4],[5,5],[5,4]];check('D02-legacy-time-boundaries-remain-correct',results.every((pair,i)=>pair.length===2&&pair.every((v,j)=>Math.abs(v-expected[i][j])<.035)),results);
 await p.evaluate(()=>{const s=window.S.getState(),source=s.project.devices[0].screenClips[0].media;s.setActiveDevice(1);s.replaceScreenClip(s.project.devices[1].screenClips[0].clipId,source);s.setScreenPlayback({in:4,out:6,start:2,loop:false})});await time(3);await ready();await p.evaluate(()=>window.V.seekScreenVideos(3,5000));const shared=await p.evaluate(()=>window.V.screenVideoStatus().map(v=>v.time));check('D03-shared-source-retains-independent-decoders',shared.length===2&&Math.abs(shared[0]-4)<.04&&Math.abs(shared[1]-5)<.04,shared)
});
await scenario('authoring-regression',async()=>{await init();await p.evaluate(()=>{const s=window.S.getState();s.setDuration(8);s.setActiveDevice(0);s.setPlayhead(0);s.setDevicePosition([-.6,0,0]);s.setPlayhead(2);s.setDevicePosition([.6,0,0])});check('E01-ordinary-edits-stay-static',await p.evaluate(()=>{const s=window.S.getState();return s.project.devices[0].transform['position.x'].keys.length===1&&window.T.sampleTimeline(s.project,0).devices[0].position[0]===window.T.sampleTimeline(s.project,2).devices[0].position[0]}));
 await p.getByText('位置与旋转精调',{exact:true}).click();await time(0);await number('缩放',.8);await number('水平位置',-.6);await number('偏航角',0);await p.getByRole('button',{name:'添加关键帧',exact:true}).click();await time(2);await number('缩放',1);await number('水平位置',.6);await number('偏航角',720);check('E02-pose-animation-has-correct-two-second-midpoint',await p.evaluate(()=>{const d=window.T.sampleTimeline(window.S.getState().project,1).devices[0];return Math.abs(d.position[0])<.001&&Math.abs(d.rotation[1]-Math.PI*2)<.001&&Math.abs(d.scale-.9)<.001}));
 await p.getByRole('button',{name:'手机 A关键帧 2秒',exact:true}).click();await p.getByRole('spinbutton',{name:'关键帧时间',exact:true}).fill('6');await p.getByRole('spinbutton',{name:'关键帧时间',exact:true}).press('Enter');check('E03-retiming-fills-the-new-six-second-span',await p.evaluate(()=>Math.abs(window.T.sampleTimeline(window.S.getState().project,3).devices[0].rotation[1]-Math.PI*2)<.001));
 await time(7);await p.getByRole('button',{name:'添加关键帧',exact:true}).click();await time(8);await number('水平位置',3);check('E04-hold-and-exit-remain-separate',await p.evaluate(()=>{const p=window.S.getState().project;return Math.abs(window.T.sampleTimeline(p,6.5).devices[0].position[0]-.6)<.001&&window.T.sampleTimeline(p,8).devices[0].position[0]===3}));
 const saved=await save('regression-animation');await open(saved);check('E05-multi-turn-rotation-survives-save-and-nonuniform-keys',await p.evaluate(()=>{const p=window.S.getState().project;return Math.abs(window.T.sampleTimeline(p,6).devices[0].rotation[1]-Math.PI*4)<.001&&Math.abs(window.T.sampleTimeline(p,3).devices[0].rotation[1]-Math.PI*2)<.001}));
 const before=JSON.stringify((await state()).devices[0]);const b=(await state()).devices[1];await p.getByTestId('object-'+b.instanceId).click();await time(2);await p.getByRole('combobox',{name:'添加动作预设',exact:true}).selectOption('spin-y-360');check('G01-device-preset-keeps-other-object-unchanged',JSON.stringify((await state()).devices[0])===before);
 await p.getByRole('button',{name:'添加文字',exact:true}).click();await p.getByRole('textbox',{name:'文字内容',exact:true}).fill('动画标题回归');await time(0);await p.getByRole('button',{name:'添加关键帧',exact:true}).click();await time(2);await number('水平位置',75);await number('透明度 %',0);check('H02-sticker-position-and-opacity-remain-animated',await p.evaluate(async()=>{const t=window.S.getState().project.texts.at(-1),pose=(await import('/src/scene/textOverlay.ts')).textPose(t,1);return Math.abs(pose.x-.625)<.001&&Math.abs(pose.opacity-.5)<.001}));
 await p.evaluate(()=>{const s=window.S.getState();for(const d of [...s.project.devices])s.removeObject({kind:'device',instanceId:d.instanceId});s.setOutput({width:1080,height:1920});s.setPlayhead(1)});const pure=await save('regression-text-only');await open(pure);check('H04-pure-text-and-portrait-project-reopen',await p.evaluate(()=>window.S.getState().project.devices.length===0&&window.S.getState().project.output.height===1920&&window.S.getState().project.texts.length===1));
 await p.evaluate(()=>{const s=window.S.getState();s.setOutput({width:1920,height:1080});s.setPlayhead(0)});
 for(const [kind,bg]of [['solid',{type:'solid',color:'#123456'}],['gradient',{type:'gradient',from:'#123456',to:'#abcdef',angle:45}],['transparent',{type:'transparent'}]]){await p.evaluate(bg=>window.S.getState().setBackground(bg),bg);await still('background-'+kind,0)}
 await p.evaluate(async()=>{const c=document.createElement('canvas');c.width=20;c.height=20;const ctx=c.getContext('2d');ctx.fillStyle='#00aa88';ctx.fillRect(0,0,20,20);const blob=await new Promise(r=>c.toBlob(r));const ref=await(await import('/src/media/loadImage.ts')).loadImageAsMediaRef(new File([blob],'background.png',{type:'image/png'}));window.S.getState().setBackground({type:'image',ref,fit:'cover'})});await still('background-image',0);const background=await save('regression-background');check('I01-four-background-types-still-render-and-save',fs.statSync(background).size>0);
 await p.evaluate(()=>{const s=window.S.getState();s.setEnvironment({hdri:'sunset',intensity:.7,shadowOpacity:.5,shadowBlur:7})});check('I02-environment-controls-still-apply',await p.evaluate(()=>{const e=window.S.getState().project.environment;return e.hdri==='sunset'&&e.intensity===.7&&e.shadowOpacity===.5}));
 await p.getByRole('tab',{name:'环境',exact:true}).click();check('I03-effects-remain-opt-in',!(await state()).effects?.depthOfField.enabled&&!(await state()).effects?.motionBlur.enabled);await p.getByRole('checkbox',{name:'景深',exact:true}).check();await p.getByRole('button',{name:'撤销',exact:true}).click();check('I03-effect-change-undo-restores-settings',!(await state()).effects?.depthOfField.enabled);await p.screenshot({path:path.join(out,'regression-environment.png'),fullPage:true});
});
await scenario('g02',async()=>{await init();await p.evaluate(()=>window.S.getState().setDuration(8));const b=(await state()).devices[1];await p.getByTestId('object-'+b.instanceId).click();await p.getByText('位置与旋转精调',{exact:true}).click();
 for(const [i,x,angle]of [[0,.2,0],[1,.3,30],[2,.4,60],[6,.6,90],[8,.8,120]]){await time(i);if(i===0)await number('缩放',.8);await number('水平位置',x);await number('偏航角',angle);if(i===0){await p.getByRole('button',{name:'添加关键帧',exact:true}).click()}}
 const a=JSON.stringify((await state()).devices[0]);await time(2);await p.getByRole('combobox',{name:'添加动作预设',exact:true}).selectOption('spin-y-360');const points=await p.evaluate(()=>{const p=window.S.getState().project;return [0,1,2,6,8].map(t=>{const d=window.T.sampleTimeline(p,t).devices[1];return [t,d.position[0],d.rotation[1]*180/Math.PI,d.scale]})});check('G02-numeric-instructions-preserve-before-range-and-position',points.every((v,i)=>Math.abs(v[1]-[.2,.3,.4,.6,.8][i])<.001&&Math.abs(v[3]-.8)<.001)&&Math.abs(points[0][2])<.001&&Math.abs(points[1][2]-30)<.001&&Math.abs(points[4][2]-420)<.001,points);check('G02-instructions-preserve-other-object',JSON.stringify((await state()).devices[0])===a);await p.getByRole('button',{name:'撤销',exact:true}).click();check('G02-undo-restores-previous-end-angle',await p.evaluate(()=>Math.abs(window.T.sampleTimeline(window.S.getState().project,8).devices[1].rotation[1]*180/Math.PI-120)<.001));await save('G02-numeric-example');
});
await scenario('occlusion',async()=>{await init();await p.evaluate(()=>{const s=window.S.getState();s.setActiveDevice(0);s.setDeviceId('iphone-17-pro');s.setDevicePosition([0,0,0]);s.setDeviceRotation([0,0,0]);s.setDeviceScale(1);s.setDisplayRange({kind:'device',instanceId:s.project.devices[1].instanceId},{start:2,end:4});s.setCameraPosition([0,0,4.5]);s.setCameraTarget([0,0,0]);s.setCameraFov(30);s.selectObject(null);s.setBackground({type:'solid',color:'#556677'})});await ready();await still('occlusion-baseline',0);
 await p.getByRole('button',{name:'添加文字',exact:true}).click();await p.getByRole('textbox',{name:'文字内容',exact:true}).fill('中文口');await number('字号',100);await number('垂直位置',50);await still('sticker-front',0);await p.getByRole('combobox',{name:'文字前后关系',exact:true}).selectOption('back');await still('sticker-back',0);
 await p.evaluate(()=>{const s=window.S.getState();s.removeObject(s.activeObject)});await p.getByRole('button',{name:'添加实体文字',exact:true}).click();await p.getByRole('textbox',{name:'文字内容',exact:true}).fill('中文口');await number('垂直位置',0);await number('纵深位置',-.6);await number('文字厚度',.1);await still('solid-occluded',0);await number('纵深位置',.5);await still('solid-in-front',0);check('solid-and-sticker-both-support-front-back-placement',true);
 await p.evaluate(()=>window.S.getState().setBackground({type:'transparent'}));await still('transparent-occlusion',0);check('transparent-output-with-solid-and-phone-renders',true);
 await p.setViewportSize({width:1000,height:760});await p.waitForTimeout(300);check('compact-window-controls-remain-usable',await p.getByRole('button',{name:'添加实体文字',exact:true}).isVisible());await p.screenshot({path:path.join(out,'compact-layout.png'),fullPage:true});
});
check('no-unhandled-page-errors',report.pageErrors.length===0,report.pageErrors);check('no-console-errors',report.consoleErrors.length===0,report.consoleErrors);report.status=report.scenarios.every(s=>s.status==='PASS')?'PASS':'FAIL';if(report.status==='FAIL')process.exitCode=1;
}catch(e){report.status='FAIL';report.error=String(e);process.exitCode=1}finally{write();await browser?.close();console.log(JSON.stringify({status:report.status,scenarios:report.scenarios,checks:report.checks.length}))}})();
